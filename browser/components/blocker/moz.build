XPIDL_SOURCES += [
    "nsIWildBuzzardBlocker.idl",
]

XPIDL_MODULE = "wildbuzzard_blocker"

UNIFIED_SOURCES += [
    "WildBuzzardBlockerXPCOM.cpp",
]

EXPORTS += [
    "WildBuzzardBlockerXPCOM.h",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

JAR_MANIFESTS += [
    "jar.mn",
]

EXTRA_JS_MODULES += [
    "WildBuzzardBlockedPage.sys.mjs",
    "WildBuzzardBlockedPageChild.sys.mjs",
    "WildBuzzardBlockedPageParent.sys.mjs",
    "WildBuzzardBlockerChild.sys.mjs",
    "WildBuzzardBlockerExtensionDetector.sys.mjs",
    "WildBuzzardBlockerPanel.sys.mjs",
    "WildBuzzardBlockerParent.sys.mjs",
    "WildBuzzardBlockerService.sys.mjs",
    "WildBuzzardBlockerStartup.sys.mjs",
    "WildBuzzardBlockerUtils.sys.mjs",
]

EXTRA_JS_MODULES.internal += [
    "internal/BundledResources.sys.mjs",
    "internal/EngineCache.sys.mjs",
    "internal/ListCatalog.sys.mjs",
    "internal/ListPreprocessor.sys.mjs",
    "internal/ListStore.sys.mjs",
    "internal/ListUpdates.sys.mjs",
    "internal/Resources.sys.mjs",
    "internal/SiteExceptions.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]

FINAL_LIBRARY = "xul"
