## about:preferences

# Main
update-application-manual =
    .label = Never check for updates (not recommended)
    .accesskey = N

## Settings panes

# Badge shown on Settings groups and controls that are exclusive to WildBuzzard.
wildbuzzard-settings-exclusive-badge = WildBuzzard Exclusive

# Product information and the supported spelling controls.
wildbuzzard-about-description =
    .label = { -brand-short-name } { $version }
    .description = An open-source browser for people and external agents. Browse normally or let an agent control tabs, pages and downloads through the wildbuzzard shell command. Based on Firefox ESR { $engine }.
wildbuzzard-about-project-heading =
    .label = Project and licences
wildbuzzard-about-licenses =
    .label = Licences and third-party notices
    .description = WildBuzzard, Firefox, Tor, the torrent engine, search plugins and spelling dictionaries.
wildbuzzard-about-source =
    .label = Source code
wildbuzzard-about-build =
    .label = Build information
wildbuzzard-about-support =
    .label = Support and report an issue
    .description = Open the WildBuzzard issue tracker on GitHub.
wildbuzzard-spelling-heading =
    .label = Spelling
wildbuzzard-spelling-enabled =
    .label = Check spelling as you type
    .description = English (United Kingdom) and English (United States) dictionaries are included. Choose the spelling language from a text field’s context menu.
