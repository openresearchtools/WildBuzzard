#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later

set -eu

runtime=/usr/lib/buzzard-agent-web
node="$runtime/node/bin/node"
package="$runtime/app/node_modules/@jmfederico/pi-web"
control="$runtime/libexec/control.mjs"

usage() {
  printf '%s\n' \
    'Usage: buzzard-agent-web COMMAND' \
    '' \
    'Commands:' \
    '  serve                 run the web/API server in the foreground' \
    '  sessiond              run the persistent-session daemon in the foreground' \
    '  endpoint [--json]     print the configured local service endpoint' \
    '  start|stop|restart    control both user services; accepts --json' \
    '  status [--json]       report URL, readiness, and both user services' \
    '  enable|disable        activate or deactivate both user services' \
    '  logs                  follow both user-service logs' \
    '  plugins ...           manage server-plugin recovery settings' \
    '  doctor                validate the installed runtime and live endpoint' \
    '  version               print package and upstream versions'
}

require_runtime() {
  if [ ! -x "$node" ] || [ ! -f "$package/dist/server/index.js" ] || [ ! -f "$package/dist/server/sessiond.js" ]; then
    echo 'buzzard-agent-web runtime is incomplete; reinstall the package' >&2
    exit 1
  fi
}

configure_runtime() {
  if [ -z "${HOME:-}" ]; then
    echo 'HOME is required' >&2
    exit 1
  fi

  agent_dir=${BUZZARD_AGENT_DIR:-${PI_CODING_AGENT_DIR:-"$HOME/.buzzard-agent/agent"}}
  export BUZZARD_AGENT_DIR="$agent_dir"
  export PI_CODING_AGENT_DIR="$agent_dir"
  export PI_WEB_AGENT_DIR=${PI_WEB_AGENT_DIR:-"$agent_dir"}
  export PI_WEB_AGENT_COMMAND=${PI_WEB_AGENT_COMMAND:-${BUZZARD_AGENT_WEB_AGENT_COMMAND:-/usr/bin/buzzard-agent}}
  export PI_WEB_HOST=${PI_WEB_HOST:-${BUZZARD_AGENT_WEB_HOST:-127.0.0.1}}
  export PI_WEB_PORT=${PI_WEB_PORT:-${BUZZARD_AGENT_WEB_PORT:-8765}}
  export PI_WEB_DATA_DIR=${PI_WEB_DATA_DIR:-${BUZZARD_AGENT_WEB_DATA_DIR:-"${XDG_DATA_HOME:-$HOME/.local/share}/wildbuzzard/agent"}}
  export PI_WEB_CONFIG=${PI_WEB_CONFIG:-${BUZZARD_AGENT_WEB_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/wildbuzzard/agent/config.json"}}
  if [ -n "${BUZZARD_AGENT_WEB_IDENTITY_FILE:-}" ]; then
    export WILDBUZZARD_PI_WEB_IDENTITY_FILE=${WILDBUZZARD_PI_WEB_IDENTITY_FILE:-"$BUZZARD_AGENT_WEB_IDENTITY_FILE"}
  fi
  if [ "${BUZZARD_AGENT_WEB_LOCAL_ONLY:-0}" = 1 ]; then
    export WILDBUZZARD_AGENT_LOCAL_ONLY=1
  fi
  export PI_SKIP_VERSION_CHECK=1
  export PI_TELEMETRY=0
  if [ -n "${BUZZARD_AGENT_WEB_OFFLINE:-}" ]; then
    export PI_OFFLINE="$BUZZARD_AGENT_WEB_OFFLINE"
  fi
}

command=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  serve)
    require_runtime
    configure_runtime
    exec "$node" "$package/dist/server/index.js" "$@"
    ;;
  sessiond)
    require_runtime
    configure_runtime
    exec "$node" "$package/dist/server/sessiond.js" "$@"
    ;;
  endpoint)
    require_runtime
    exec "$node" "$control" endpoint "$@"
    ;;
  start|stop|restart|status|enable|disable)
    require_runtime
    exec "$node" "$control" "$command" "$@"
    ;;
  logs)
    exec journalctl --user -u buzzard-agent-web-sessiond.service -u buzzard-agent-web.service -f "$@"
    ;;
  plugins)
    require_runtime
    configure_runtime
    exec "$node" "$control" plugins "$@"
    ;;
  doctor)
    require_runtime
    configure_runtime
    test -x "$PI_WEB_AGENT_COMMAND" || {
      echo "companion agent is not executable: $PI_WEB_AGENT_COMMAND" >&2
      exit 1
    }
    origin=$("$node" "$control" endpoint)
    "$node" -e 'fetch(process.argv[1] + "/api/machines/local/health").then(async response => { const body = await response.text(); if (!response.ok) throw new Error(`HTTP ${response.status}: ${body}`); console.log(body); }).catch(error => { console.error(`Buzzard Agent Web is not healthy: ${error.message}`); process.exitCode = 1; });' "$origin"
    ;;
  version)
    printf '%s\n' 'buzzard-agent-web 1.202608.0+wildbuzzard1' 'Pi Web upstream 1.202608.0 (1d86c2269cc70e09a2af739f73767d9bbf80d9c0)' 'Node.js 22.23.2'
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
