#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later

set -eu

export PI_SKIP_VERSION_CHECK=1
export PI_TELEMETRY=0

if [ "${BUZZARD_AGENT_OFFLINE:-}" ]; then
  export PI_OFFLINE="${BUZZARD_AGENT_OFFLINE}"
fi
if [ "${BUZZARD_AGENT_PACKAGE_DIR:-}" ]; then
  export PI_PACKAGE_DIR="${BUZZARD_AGENT_PACKAGE_DIR}"
fi

capability_extension=/usr/lib/buzzard-agent/app/extensions/buzzard-capabilities/index.ts
load_capabilities=${BUZZARD_AGENT_CAPABILITY_EXTENSION:-1}
for argument in "$@"; do
  if [ "$argument" = "--no-extensions" ] || [ "$argument" = "-ne" ]; then
    load_capabilities=0
  fi
done
if [ "$load_capabilities" != 0 ] && [ -f "$capability_extension" ]; then
  set -- --extension "$capability_extension" "$@"
fi

exec /usr/lib/buzzard-agent/node/bin/node /usr/lib/buzzard-agent/app/node_modules/@earendil-works/pi-coding-agent/dist/cli.js "$@"
