#!/usr/bin/make -f
# SPDX-License-Identifier: AGPL-3.0-or-later

%:
	dh $@

override_dh_auto_build:
	./scripts/build-runtime.sh ../../third_party/mit/pi/upstream debian/build/runtime

override_dh_auto_test:
	python3 -m unittest discover -s tests -p 'test_*.py'

override_dh_auto_install:
	mkdir -p debian/buzzard-agent/usr/bin debian/buzzard-agent/usr/lib/buzzard-agent debian/buzzard-agent/usr/share/doc/buzzard-agent
	cp -a debian/build/runtime debian/buzzard-agent/usr/lib/buzzard-agent/app
	install -m 0755 bin/buzzard-agent debian/buzzard-agent/usr/bin/buzzard-agent
	install -m 0644 ../../third_party/mit/pi/upstream/LICENSE debian/buzzard-agent/usr/share/doc/buzzard-agent/LICENSE.upstream
	install -m 0644 NOTICE debian/buzzard-agent/usr/share/doc/buzzard-agent/NOTICE
