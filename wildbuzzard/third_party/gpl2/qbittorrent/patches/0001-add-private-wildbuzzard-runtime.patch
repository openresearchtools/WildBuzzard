+{
+    bool privatePath(const QString &path, const bool directory)
+    {
+#ifdef Q_OS_UNIX
+        const QFileInfo info {path};
+        return info.isAbsolute() && !info.isSymLink() && (info.ownerId() == geteuid())
+            && (info.permissions() & (QFileDevice::ReadGroup | QFileDevice::WriteGroup | QFileDevice::ExeGroup
+                | QFileDevice::ReadOther | QFileDevice::WriteOther | QFileDevice::ExeOther)) == 0
+            && (directory ? info.isDir() : info.isFile());
+#else
+        Q_UNUSED(path);
+        Q_UNUSED(directory);
+        return false;
+#endif
+    }
+
+    bool validWildBuzzardConfiguration(const QString &socketPath, const bool socketIsOwned)
+    {
+        if (socketPath.toUtf8().size() >= 100 || (QFileInfo::exists(socketPath) && !socketIsOwned)
+            || !privatePath(QFileInfo(socketPath).absolutePath(), true))
+        {
+            return false;
+        }
+
+        const QString keyPath = qEnvironmentVariable("WILDBUZZARD_QBITTORRENT_API_KEY_FILE");
+        if (!privatePath(keyPath, false))
+            return false;
+        const auto key = Utils::IO::readFile(Path(keyPath), 128);
+        return key && Utils::APIKey::isValid(QString::fromUtf8(key.value()).trimmed());
+    }
+}
