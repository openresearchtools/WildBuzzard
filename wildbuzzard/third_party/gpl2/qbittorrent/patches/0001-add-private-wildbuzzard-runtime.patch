diff --git a/src/webui/www/private/scripts/wildbuzzard-bridge.js b/src/webui/www/private/scripts/wildbuzzard-bridge.js
new file mode 100644
--- /dev/null
+++ b/src/webui/www/private/scripts/wildbuzzard-bridge.js
@@ -0,0 +1,190 @@
+"use strict";
+
+(() => {
+    const NativeFetch = window.fetch.bind(window);
+    const NativeEvent = window.Event;
+    const NativeRequest = window.Request;
+    const NativeURL = window.URL;
+    const TorrentRequest = (...args) =>
+        window.WildBuzzardTorrentRequest(...args);
+
+    class BridgeURL extends NativeURL {
+        constructor(input, base) {
+            super(input, String(base).startsWith("about:torrents") ? document.baseURI : base);
+        }
+    }
+    window.URL = BridgeURL;
+
+    const requestURL = (input) => new URL(
+        input instanceof NativeRequest ? input.url : String(input),
+        document.baseURI
+    );
+
+    const bridgeFetch = async (input, init) => {
+        const url = requestURL(input);
+        const request = new NativeRequest(url, init);
+        if ((url.protocol !== "moz-torrent:") || (url.host !== "local"))
+            return NativeFetch(request);
+
+        const body = ["GET", "HEAD"].includes(request.method)
+            ? new Uint8Array()
+            : new Uint8Array(await request.arrayBuffer());
+        const result = await TorrentRequest({
+            method: request.method,
+            target: `${url.pathname}${url.search}`,
+            headers: Object.fromEntries(request.headers),
+            body,
+        }, request.signal);
+        if ((request.method === "POST") && (result.status >= 200) && (result.status < 300)) {
+            for (const delay of [0, 250, 1000, 2500])
+                window.parent.setTimeout(() => window.parent.updateMainData?.(), delay);
+        }
+        return new Response(result.body.length ? result.body : null, {
+            status: result.status,
+            headers: result.headers,
+        });
+    };
+
+    window.fetch = bridgeFetch;
+
+    class BridgeXMLHttpRequest extends EventTarget {
+        constructor() {
+            super();
+            this.readyState = BridgeXMLHttpRequest.UNSENT;
+            this.response = null;
+            this.responseText = "";
+            this.responseType = "";
+            this.responseURL = "";
+            this.status = 0;
+            this.statusText = "";
+            this.timeout = 0;
+            this.upload = new EventTarget();
+            this.withCredentials = false;
+            this.requestHeaders = new Headers();
+            this.responseHeaders = new Headers();
+            this.controller = null;
+            this.aborted = false;
+            this.timedOut = false;
+        }
+
+        open(method, url, async = true) {
+            if (!async)
+                throw new DOMException("Synchronous requests are unavailable", "NotSupportedError");
+            this.method = String(method).toUpperCase();
+            this.url = requestURL(url).href;
+            this.readyState = BridgeXMLHttpRequest.OPENED;
+            this.emit("readystatechange");
+        }
+
+        setRequestHeader(name, value) {
+            if (this.readyState !== BridgeXMLHttpRequest.OPENED)
+                throw new DOMException("The request is not open", "InvalidStateError");
+            this.requestHeaders.append(name, value);
+        }
+
+        getResponseHeader(name) {
+            return this.responseHeaders.get(name);
+        }
+
+        getAllResponseHeaders() {
+            return [...this.responseHeaders]
+                .map(([name, value]) => `${name}: ${value}\r\n`)
+                .join("");
+        }
+
+        overrideMimeType() {}
+
+        abort() {
+            this.aborted = true;
+            this.controller?.abort();
+        }
+
+        async send(body = null) {
+            if (this.readyState !== BridgeXMLHttpRequest.OPENED)
+                throw new DOMException("The request is not open", "InvalidStateError");
+            this.controller = new AbortController();
+            this.aborted = false;
+            this.timedOut = false;
+            this.emit("loadstart");
+            let timer = null;
+            if (this.timeout > 0) {
+                timer = setTimeout(() => {
+                    this.timedOut = true;
+                    this.controller.abort();
+                }, this.timeout);
+            }
+            try {
+                const result = await bridgeFetch(this.url, {
+                    method: this.method,
+                    headers: this.requestHeaders,
+                    body: ["GET", "HEAD"].includes(this.method) ? null : body,
+                    signal: this.controller.signal,
+                });
+                this.status = result.status;
+                this.statusText = result.statusText;
+                this.responseURL = this.url;
+                this.responseHeaders = new Headers(result.headers);
+                this.readyState = BridgeXMLHttpRequest.HEADERS_RECEIVED;
+                this.emit("readystatechange");
+                const bytes = await result.arrayBuffer();
+                this.readyState = BridgeXMLHttpRequest.LOADING;
+                this.emit("readystatechange");
+                if (this.responseType === "arraybuffer") {
+                    this.response = bytes;
+                }
+                else if (this.responseType === "blob") {
+                    this.response = new Blob([bytes], {
+                        type: this.responseHeaders.get("content-type") ?? "",
+                    });
+                }
+                else {
+                    this.responseText = new TextDecoder().decode(bytes);
+                    this.response = this.responseType === "json"
+                        ? JSON.parse(this.responseText)
+                        : this.responseText;
+                }
+                this.readyState = BridgeXMLHttpRequest.DONE;
+                this.emit("readystatechange");
+                this.emit("load");
+            }
+            catch (error) {
+                this.status = 0;
+                this.readyState = BridgeXMLHttpRequest.DONE;
+                this.emit("readystatechange");
+                if (this.timedOut)
+                    this.emit("timeout");
+                else if (this.aborted)
+                    this.emit("abort");
+                else
+                    this.emit("error");
+            }
+            finally {
+                if (timer !== null)
+                    clearTimeout(timer);
+                this.emit("loadend");
+            }
+        }
+
+        emit(type) {
+            const event = new NativeEvent(type);
+            this.dispatchEvent(event);
+            this[`on${type}`]?.call(this, event);
+        }
+    }
+
+    Object.assign(BridgeXMLHttpRequest, {
+        UNSENT: 0,
+        OPENED: 1,
+        HEADERS_RECEIVED: 2,
+        LOADING: 3,
+        DONE: 4,
+    });
+    Object.assign(BridgeXMLHttpRequest.prototype, {
+        UNSENT: 0,
+        OPENED: 1,
+        HEADERS_RECEIVED: 2,
+        LOADING: 3,
+        DONE: 4,
+    });
+    window.XMLHttpRequest = BridgeXMLHttpRequest;
+})();
