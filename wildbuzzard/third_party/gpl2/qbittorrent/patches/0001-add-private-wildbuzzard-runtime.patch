+void Server::acceptLocalConnections()
+{
+    while (m_localServer->hasPendingConnections())
+    {
+        std::unique_ptr<QLocalSocket> socket {m_localServer->nextPendingConnection()};
+        if (!socket)
+            return;
+
+        if (m_connections.size() >= CONNECTIONS_LIMIT)
+        {
+            qWarning("Too many connections. Exceeded CONNECTIONS_LIMIT (%d). Connection closed.", CONNECTIONS_LIMIT);
+            continue;
+        }
+
+        try
+        {
+            const Environment environment {QHostAddress::LocalHost, 0, QHostAddress::LocalHost, 0};
+            auto *connection = new Connection(socket.release(), environment, u"local"_s, m_requestHandler, this);
+            m_connections.insert(connection);
+            connect(connection, &Connection::closed, this, [this, connection] { removeConnection(connection); });
+        }
+        catch (const std::bad_alloc &)
+        {
+            qWarning("Failed to allocate memory for HTTP connection. Connection closed.");
+        }
+    }
+}
+
+bool Server::listenLocal(const QString &socketPath)
+{
+    QTcpServer::close();
+    m_localServer->close();
+    m_localServer->setSocketOptions(QLocalServer::UserAccessOption);
+    m_localMode = true;
+    if (!m_localServer->listen(socketPath))
+        return false;
+    if (!QFile::setPermissions(socketPath, QFileDevice::ReadOwner | QFileDevice::WriteOwner))
+    {
+        m_localServer->close();
+        QLocalServer::removeServer(socketPath);
+        return false;
+    }
+    return true;
+}
+
+bool Server::listen(const QHostAddress &address, const quint16 port)
+{
+    m_localServer->close();
+    m_localMode = false;
+    return QTcpServer::listen(address, port);
+}
+
+void Server::close()
+{
+    QTcpServer::close();
+    m_localServer->close();
+}
+
+bool Server::isListening() const
+{
+    return m_localMode ? m_localServer->isListening() : QTcpServer::isListening();
+}
+
+QString Server::errorString() const
+{
+    return m_localMode ? m_localServer->errorString() : QTcpServer::errorString();
+}
+
+QHostAddress Server::serverAddress() const
+{
+    return m_localMode ? QHostAddress::LocalHost : QTcpServer::serverAddress();
+}
+
+quint16 Server::serverPort() const
+{
+    return m_localMode ? 0 : QTcpServer::serverPort();
+}
+
+bool Server::isLocal() const
+{
+    return m_localMode;
+}
+
 void Server::removeConnection(Connection *connection)
 {
     m_connections.remove(connection);
