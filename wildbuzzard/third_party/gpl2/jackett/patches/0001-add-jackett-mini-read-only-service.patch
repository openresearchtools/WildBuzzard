diff --git a/src/Jackett.Mini/MiniOptions.cs b/src/Jackett.Mini/MiniOptions.cs
new file mode 100644
index 000000000..bc1b3d868
--- /dev/null
+++ b/src/Jackett.Mini/MiniOptions.cs
@@ -0,0 +1,116 @@
+using System.Security.Cryptography;
+using System.Text;
+
+namespace Jackett.Mini;
+
+internal sealed record MiniOptions(int Port, string DataFolder, string PidFile, string CapabilityFile)
+{
+    public static MiniOptions Parse(string[] args)
+    {
+        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        var flags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        for (var index = 0; index < args.Length; index++)
+        {
+            var argument = args[index];
+            if (!argument.StartsWith("--", StringComparison.Ordinal))
+                throw new ArgumentException("Only named options are accepted");
+            var name = argument[2..];
+            if (name is "ListenPrivate" or "NoUpdates" or "NoRestart")
+            {
+                if (!flags.Add(name))
+                    throw new ArgumentException($"Duplicate option --{name}");
+                continue;
+            }
+            if (name is not ("Port" or "DataFolder" or "PIDFile" or "CapabilityFile") || index + 1 >= args.Length)
+                throw new ArgumentException($"Unsupported or incomplete option --{name}");
+            if (!values.TryAdd(name, args[++index]))
+                throw new ArgumentException($"Duplicate option --{name}");
+        }
+        foreach (var required in new[] { "ListenPrivate", "NoUpdates", "NoRestart" })
+            if (!flags.Contains(required))
+                throw new ArgumentException($"Required option --{required} is missing");
+        foreach (var required in new[] { "Port", "DataFolder", "PIDFile", "CapabilityFile" })
+            if (!values.ContainsKey(required))
+                throw new ArgumentException($"Required option --{required} is missing");
+        if (!int.TryParse(values["Port"], out var port) || port is < 1024 or > 65535)
+            throw new ArgumentException("Port must be between 1024 and 65535");
+        return new MiniOptions(
+            port,
+            Path.GetFullPath(values["DataFolder"]),
+            Path.GetFullPath(values["PIDFile"]),
+            Path.GetFullPath(values["CapabilityFile"]));
+    }
+
+    public string ReadCapability()
+    {
+        var info = new FileInfo(CapabilityFile);
+        if (!info.Exists || info.LinkTarget is not null)
+            throw new InvalidOperationException("Capability file is missing or is a symbolic link");
+        if (!OperatingSystem.IsWindows())
+        {
+            var mode = File.GetUnixFileMode(CapabilityFile);
+            const UnixFileMode forbidden = UnixFileMode.GroupRead | UnixFileMode.GroupWrite |
+                UnixFileMode.GroupExecute | UnixFileMode.OtherRead | UnixFileMode.OtherWrite |
+                UnixFileMode.OtherExecute;
+            if ((mode & forbidden) != 0)
+                throw new InvalidOperationException("Capability file permissions must be 0600 or stricter");
+        }
+        var capability = File.ReadAllText(CapabilityFile, Encoding.ASCII).Trim();
+        if (capability.Length < 43 || capability.Length > 128 || capability.Any(c => !char.IsAsciiLetterOrDigit(c) && c is not '-' and not '_'))
+            throw new InvalidOperationException("Capability file is invalid");
+        return capability;
+    }
+
+    public void PrepareState()
+    {
+        Directory.CreateDirectory(DataFolder);
+        if (new DirectoryInfo(DataFolder).LinkTarget is not null)
+            throw new InvalidOperationException("Data folder cannot be a symbolic link");
+        if (!OperatingSystem.IsWindows())
+            File.SetUnixFileMode(DataFolder, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);
+        var pidDirectory = Path.GetDirectoryName(PidFile) ?? throw new InvalidOperationException("PID file has no parent");
+        Directory.CreateDirectory(pidDirectory);
+        using var stream = new FileStream(PidFile, FileMode.CreateNew, FileAccess.Write, FileShare.Read, 64, FileOptions.WriteThrough);
+        using var writer = new StreamWriter(stream, Encoding.ASCII, leaveOpen: true);
+        writer.Write(Environment.ProcessId);
+        writer.Flush();
+        stream.Flush(true);
+        if (!OperatingSystem.IsWindows())
+            File.SetUnixFileMode(PidFile, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+        EnsureDataRootId();
+    }
+
+    private void EnsureDataRootId()
+    {
+        var path = Path.Combine(DataFolder, "data-root-id");
+        var info = new FileInfo(path);
+        if (info.Exists && info.LinkTarget is not null)
+            throw new InvalidOperationException("Data root identity cannot be a symbolic link");
+        if (!File.Exists(path))
+        {
+            var value = Convert.ToHexString(RandomNumberGenerator.GetBytes(16)).ToLowerInvariant();
+            using var stream = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read, 64, FileOptions.WriteThrough);
+            using var writer = new StreamWriter(stream, Encoding.ASCII, leaveOpen: true);
+            writer.Write(value);
+            writer.Flush();
+            stream.Flush(true);
+        }
+        var identity = File.ReadAllText(path, Encoding.ASCII).Trim();
+        if (identity.Length != 32 || identity.Any(character => !char.IsAsciiHexDigit(character) || char.IsAsciiLetter(character) && char.IsUpper(character)))
+            throw new InvalidOperationException("Data root identity is invalid");
+        if (!OperatingSystem.IsWindows())
+            File.SetUnixFileMode(path, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+    }
+
+    public void RemoveOwnedPidFile()
+    {
+        try
+        {
+            if (File.Exists(PidFile) && File.ReadAllText(PidFile).Trim() == Environment.ProcessId.ToString())
+                File.Delete(PidFile);
+        }
+        catch
+        {
+        }
+    }
+}
diff --git a/src/Jackett.Mini/Program.cs b/src/Jackett.Mini/Program.cs
new file mode 100644
index 000000000..2931d6a15
--- /dev/null
+++ b/src/Jackett.Mini/Program.cs
@@ -0,0 +1,166 @@
+using System.Diagnostics;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using Jackett.Mini;
+
+if (args.SequenceEqual(new[] { "--SecuritySelfTest" }))
+{
+    await SecuritySelfTest.Run();
+    return 0;
+}
+
+MiniOptions options;
+try
+{
+    options = MiniOptions.Parse(args);
+    options.PrepareState();
+}
+catch (Exception error)
+{
+    Console.Error.WriteLine(error.Message);
+    return 2;
+}
+
+try
+{
+    Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+    var capability = options.ReadCapability();
+    var catalog = new CatalogPolicy(Path.Combine(AppContext.BaseDirectory, "catalog.json"));
+    var instanceId = Convert.ToHexString(RandomNumberGenerator.GetBytes(16)).ToLowerInvariant();
+    var process = Process.GetCurrentProcess();
+    var executablePath = Path.GetFullPath(Environment.ProcessPath ?? throw new InvalidOperationException("Executable path is unavailable"));
+    var executableSha256 = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(executablePath))).ToLowerInvariant();
+    var dataRootId = File.ReadAllText(Path.Combine(options.DataFolder, "data-root-id"), Encoding.ASCII).Trim();
+    var builder = WebApplication.CreateSlimBuilder(args);
+    builder.Logging.ClearProviders();
+    builder.WebHost.UseUrls($"http://127.0.0.1:{options.Port}");
+    builder.WebHost.ConfigureKestrel(server =>
+    {
+        server.AddServerHeader = false;
+        server.Limits.MaxRequestBodySize = 64 * 1024;
+        server.Limits.RequestHeadersTimeout = TimeSpan.FromSeconds(5);
+        server.Limits.KeepAliveTimeout = TimeSpan.FromSeconds(30);
+    });
+    builder.Services.ConfigureHttpJsonOptions(json =>
+    {
+        json.SerializerOptions.PropertyNameCaseInsensitive = false;
+        json.SerializerOptions.UnmappedMemberHandling = System.Text.Json.Serialization.JsonUnmappedMemberHandling.Disallow;
+        json.SerializerOptions.MaxDepth = 16;
+    });
+    builder.Services.AddSingleton(options);
+    builder.Services.AddSingleton(catalog);
+    builder.Services.AddSingleton<IndexerRegistry>();
+    builder.Services.AddSingleton<ResultStore>();
+    builder.Services.AddSingleton<DiscoveryService>();
+    var app = builder.Build();
+    app.Use(async (context, next) =>
+    {
+        if (!IPAddress.IsLoopback(context.Connection.RemoteIpAddress ?? IPAddress.None) ||
+            !string.Equals(context.Request.Host.Host, "127.0.0.1", StringComparison.Ordinal) ||
+            context.Request.Host.Port != options.Port ||
+            context.Request.Headers.ContainsKey("Origin"))
+        {
+            context.Response.StatusCode = StatusCodes.Status403Forbidden;
+            return;
+        }
+        var authorization = context.Request.Headers.Authorization.ToString();
+        var supplied = authorization.StartsWith("Bearer ", StringComparison.Ordinal) ? authorization[7..] : string.Empty;
+        var expectedBytes = Encoding.ASCII.GetBytes(capability);
+        var suppliedBytes = Encoding.ASCII.GetBytes(supplied);
+        if (expectedBytes.Length != suppliedBytes.Length || !CryptographicOperations.FixedTimeEquals(expectedBytes, suppliedBytes))
+        {
+            context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+        if (context.Request.Query.Keys.Any(key => key.Equals("apikey", StringComparison.OrdinalIgnoreCase) ||
+                key.Equals("passkey", StringComparison.OrdinalIgnoreCase) || key.Equals("token", StringComparison.OrdinalIgnoreCase) ||
+                key.Equals("capability", StringComparison.OrdinalIgnoreCase)))
+        {
+            context.Response.StatusCode = StatusCodes.Status400BadRequest;
+            return;
+        }
+        context.Response.Headers.CacheControl = "no-store";
+        context.Response.Headers.XContentTypeOptions = "nosniff";
+        await next();
+    });
+    app.MapGet("/v1/health", () => Results.Json(new
+    {
+        status = "ok",
+        protocolVersion = 1,
+        runtimeVersion = CatalogPolicy.Version,
+        commit = CatalogPolicy.Commit,
+        instanceId,
+        processId = Environment.ProcessId,
+        processStartTimeUtc = process.StartTime.ToUniversalTime(),
+        executablePath,
+        executableSha256,
+        dataRootId,
+        catalogSha256 = catalog.FileSha256,
+        catalogPolicySha256 = catalog.Document.PolicySha256,
+    }));
+    app.MapGet("/v1/version", () => Results.Json(new
+    {
+        protocolVersion = 1,
+        runtimeVersion = CatalogPolicy.Version,
+        commit = CatalogPolicy.Commit,
+        catalogSha256 = catalog.FileSha256,
+        catalogPolicySha256 = catalog.Document.PolicySha256,
+    }));
+    app.MapGet("/v1/sources", (DiscoveryService discovery) => Results.Json(discovery.Sources()));
+    app.MapPost("/v1/search", async (HttpContext context, DiscoveryService discovery, CancellationToken cancellationToken) =>
+    {
+        if (!context.Request.HasJsonContentType())
+            return Results.BadRequest(new { error = "invalid-request" });
+        SearchRequest? request;
+        try
+        {
+            request = await context.Request.ReadFromJsonAsync<SearchRequest>(JsonDefaults.Options, cancellationToken);
+        }
+        catch (JsonException)
+        {
+            return Results.BadRequest(new { error = "invalid-request" });
+        }
+        if (request is null)
+            return Results.BadRequest(new { error = "invalid-request" });
+        try
+        {
+            return Results.Json(await discovery.Search(request, cancellationToken));
+        }
+        catch (BadHttpRequestException)
+        {
+            return Results.BadRequest(new { error = "invalid-request" });
+        }
+    });
+    app.MapPost("/v1/results/{id}/resolve", async (string id, DiscoveryService discovery, CancellationToken cancellationToken) =>
+    {
+        try
+        {
+            var result = await discovery.Resolve(id, cancellationToken);
+            return result is null ? Results.NotFound(new { error = "unknown-or-expired-result" }) : Results.Json(result);
+        }
+        catch (OperationCanceledException)
+        {
+            return Results.Json(new { error = "resolution-timeout" }, statusCode: StatusCodes.Status504GatewayTimeout);
+        }
+        catch
+        {
+            return Results.Json(new { error = "resolution-failed" }, statusCode: StatusCodes.Status502BadGateway);
+        }
+    });
+    app.MapFallback(async context =>
+    {
+        context.Response.StatusCode = StatusCodes.Status404NotFound;
+        await context.Response.WriteAsJsonAsync(new { error = "not-found" });
+    });
+    app.Lifetime.ApplicationStopped.Register(options.RemoveOwnedPidFile);
+    await app.RunAsync();
+    return 0;
+}
+catch (Exception error)
+{
+    Console.Error.WriteLine(error.Message);
+    options.RemoveOwnedPidFile();
+    return 1;
+}
