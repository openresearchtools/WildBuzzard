@@ -0,0 +1,71 @@
+using System;
+using System.IO;
+using System.Xml;
+
+namespace Jackett.Common.Utils
+{
+    public static class BoundedXmlValidator
+    {
+        private const int MaximumBytes = 4 * 1024 * 1024;
+        private const int MaximumNodes = 50_000;
+        private const int MaximumDepth = 64;
+        private const int MaximumAttributes = 32_768;
+        private const int MaximumAttributesPerElement = 128;
+        private const int MaximumAttributeCharacters = 1024 * 1024;
+        private const int MaximumTextCharacters = 1024 * 1024;
+        private const int MaximumNodeCharacters = 64 * 1024;
+        private const int MaximumResults = 2_000;
+
+        public static void Validate(byte[] bytes)
+        {
+            if (bytes.Length > MaximumBytes)
+                throw new InvalidOperationException("Provider XML exceeded the byte limit");
+            var settings = new XmlReaderSettings
+            {
+                DtdProcessing = DtdProcessing.Prohibit,
+                MaxCharactersFromEntities = 0,
+                MaxCharactersInDocument = MaximumBytes,
+                XmlResolver = null,
+            };
+            using var stream = new MemoryStream(bytes, writable: false);
+            using var reader = XmlReader.Create(stream, settings);
+            var nodes = 0;
+            var attributes = 0;
+            var attributeCharacters = 0;
+            var textCharacters = 0;
+            var results = 0;
+            while (reader.Read())
+            {
+                if (++nodes > MaximumNodes)
+                    throw new InvalidOperationException("Provider XML exceeded the node limit");
+                if (reader.Depth > MaximumDepth)
+                    throw new InvalidOperationException("Provider XML exceeded the depth limit");
+                if (reader.NodeType == XmlNodeType.Element)
+                {
+                    if (reader.AttributeCount > MaximumAttributesPerElement ||
+                        (attributes += reader.AttributeCount) > MaximumAttributes)
+                        throw new InvalidOperationException("Provider XML exceeded the attribute limit");
+                    if (reader.HasAttributes)
+                    {
+                        for (var index = 0; index < reader.AttributeCount; index++)
+                        {
+                            reader.MoveToAttribute(index);
+                            if (reader.Value.Length > MaximumNodeCharacters ||
+                                (attributeCharacters += reader.Value.Length) > MaximumAttributeCharacters)
+                                throw new InvalidOperationException("Provider XML exceeded the attribute text limit");
+                        }
+                        reader.MoveToElement();
+                    }
+                    if (reader.LocalName == "item" && ++results > MaximumResults)
+                        throw new InvalidOperationException("Provider XML exceeded the result limit");
+                }
+                if (reader.NodeType is XmlNodeType.Text or XmlNodeType.CDATA or XmlNodeType.Whitespace or XmlNodeType.SignificantWhitespace)
+                {
+                    if (reader.Value.Length > MaximumNodeCharacters ||
+                        (textCharacters += reader.Value.Length) > MaximumTextCharacters)
+                        throw new InvalidOperationException("Provider XML exceeded the text limit");
+                }
+            }
+        }
+    }
+}
