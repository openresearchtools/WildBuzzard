diff --git a/src/Jackett.Mini/IndexerRegistry.cs b/src/Jackett.Mini/IndexerRegistry.cs
new file mode 100644
index 000000000..de6237474
--- /dev/null
+++ b/src/Jackett.Mini/IndexerRegistry.cs
@@ -0,0 +1,126 @@
+using System.Reflection;
+using System.Security.Cryptography;
+using Jackett.Common.Indexers;
+using Jackett.Common.Indexers.Definitions;
+using Jackett.Common.Models;
+using Jackett.Common.Models.Config;
+using Jackett.Common.Services;
+using Jackett.Common.Services.Interfaces;
+using Jackett.Common.Utils.Clients;
+using NLog;
+using YamlDotNet.Serialization;
+using YamlDotNet.Serialization.NamingConventions;
+
+namespace Jackett.Mini;
+
+internal sealed record SourceState(CatalogEntry Entry, IWebIndexer? Indexer, string State);
+
+internal sealed class IndexerRegistry
+{
+    private readonly IReadOnlyDictionary<string, SourceState> _sources;
+
+    public IndexerRegistry(CatalogPolicy policy, MiniOptions options)
+    {
+        LogManager.Configuration = new NLog.Config.LoggingConfiguration();
+        var logger = LogManager.GetLogger("JackettMiniEngine");
+        var runtime = new RuntimeSettings
+        {
+            CustomDataFolder = options.DataFolder,
+            NoUpdates = true,
+            NoRestart = true,
+            IgnoreSslErrors = false,
+            ClientOverride = "httpclient2",
+        };
+        var server = new ServerConfig(runtime)
+        {
+            AllowExternal = false,
+            AllowCORS = false,
+            CacheEnabled = true,
+            CacheTtl = 300,
+            CacheMaxResultsPerIndexer = 300,
+            FlareSolverrUrl = null,
+            ProxyType = ProxyType.Disabled,
+            UpdateDisabled = true,
+        };
+        var globalConfig = new ImmutableConfigurationService(AppContext.BaseDirectory, options.DataFolder, server);
+        var indexerConfig = new ImmutableIndexerConfigurationService();
+        var protection = new IdentityProtectionService();
+        var cache = new CacheService(logger, server);
+        var process = new ProcessService(logger);
+        var states = new Dictionary<string, SourceState>(StringComparer.Ordinal);
+        foreach (var entry in policy.Enabled.Values.OrderBy(entry => entry.IndexerId, StringComparer.Ordinal))
+        {
+            try
+            {
+                var client = new DirectWebClient(process, logger, globalConfig, server);
+                client.SetTimeout(15);
+                IWebIndexer indexer = entry.SourceKind switch
+                {
+                    "cardigann-yaml" => LoadCardigann(entry, client, indexerConfig, protection, cache, logger),
+                    "native-csharp" => LoadNative(entry, client, indexerConfig, protection, cache, logger),
+                    _ => throw new InvalidOperationException("Unsupported provider source kind"),
+                };
+                if (indexer.Id != entry.IndexerId || indexer.Type != "public")
+                    throw new InvalidOperationException("Provider identity differs from immutable catalog");
+                states.Add(entry.IndexerId, new SourceState(entry, indexer, "ready"));
+            }
+            catch
+            {
+                states.Add(entry.IndexerId, new SourceState(entry, null, "unavailable"));
+            }
+        }
+        _sources = states;
+    }
+
+    public IReadOnlyCollection<SourceState> Sources => _sources.Values.ToArray();
+
+    public SourceState Get(string id) => _sources.TryGetValue(id, out var source)
+        ? source
+        : throw new KeyNotFoundException("Source is not in the immutable eligible catalog");
+
+    private static IWebIndexer LoadCardigann(
+        CatalogEntry entry,
+        WebClient client,
+        IIndexerConfigurationService indexerConfig,
+        IProtectionService protection,
+        ICacheService cache,
+        Logger logger)
+    {
+        var path = Path.Combine(AppContext.BaseDirectory, "Definitions", Path.GetFileName(entry.SourcePath));
+        VerifyDefinition(path, entry.DefinitionSha256);
+        var deserializer = new DeserializerBuilder().WithNamingConvention(CamelCaseNamingConvention.Instance).Build();
+        var definition = deserializer.Deserialize<IndexerDefinition>(File.ReadAllText(path));
+        if (definition.Id != entry.IndexerId)
+            throw new InvalidOperationException("Definition id changed");
+        return new CardigannIndexer(indexerConfig, client, logger, protection, cache, definition);
+    }
+
+    private static IWebIndexer LoadNative(
+        CatalogEntry entry,
+        WebClient client,
+        IIndexerConfigurationService indexerConfig,
+        IProtectionService protection,
+        ICacheService cache,
+        Logger logger)
+    {
+        if (string.IsNullOrWhiteSpace(entry.NativeType))
+            throw new InvalidOperationException("Native provider has no reviewed type");
+        var type = typeof(CardigannIndexer).Assembly.GetType(entry.NativeType, throwOnError: true, ignoreCase: false)
+            ?? throw new InvalidOperationException("Native provider type is absent");
+        var constructor = type.GetConstructor(new[]
+        {
+            typeof(IIndexerConfigurationService), typeof(WebClient), typeof(Logger),
+            typeof(IProtectionService), typeof(ICacheService),
+        }) ?? throw new InvalidOperationException("Native provider constructor changed");
+        return (IWebIndexer)constructor.Invoke(new object[] { indexerConfig, client, logger, protection, cache });
+    }
+
+    private static void VerifyDefinition(string path, string expected)
+    {
+        if (!File.Exists(path))
+            throw new InvalidOperationException("Reviewed definition is absent");
+        var actual = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path))).ToLowerInvariant();
+        if (!CryptographicOperations.FixedTimeEquals(Convert.FromHexString(actual), Convert.FromHexString(expected)))
+            throw new InvalidOperationException("Definition digest changed");
+    }
+}
