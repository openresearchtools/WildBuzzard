diff --git a/src/Jackett.Mini/BencodeValidator.cs b/src/Jackett.Mini/BencodeValidator.cs
new file mode 100644
index 000000000..4c139c05d
--- /dev/null
+++ b/src/Jackett.Mini/BencodeValidator.cs
@@ -0,0 +1,127 @@
+using System.Text;
+
+namespace Jackett.Mini;
+
+internal static class BencodeValidator
+{
+    private const int MaximumBytes = 12 * 1024 * 1024;
+    private const int MaximumDepth = 64;
+    private const int MaximumItems = 200_000;
+
+    public static void ValidatePublicTorrent(byte[] bytes)
+    {
+        if (bytes.Length is 0 or > MaximumBytes)
+            throw new InvalidOperationException("Torrent payload size is invalid");
+        var parser = new Parser(bytes);
+        var root = parser.ReadValue(0, false, false);
+        if (root != ValueKind.Dictionary || parser.Offset != bytes.Length)
+            throw new InvalidOperationException("Torrent payload is not a canonical dictionary");
+        if (parser.PrivateFlag)
+            throw new InvalidOperationException("Private torrents are not accepted from discovery providers");
+    }
+
+    private enum ValueKind
+    {
+        Bytes,
+        Integer,
+        List,
+        Dictionary,
+    }
+
+    private ref struct Parser
+    {
+        private readonly ReadOnlySpan<byte> _bytes;
+        private int _items;
+        public int Offset { get; private set; }
+        public bool PrivateFlag { get; private set; }
+
+        public Parser(ReadOnlySpan<byte> bytes)
+        {
+            _bytes = bytes;
+        }
+
+        public ValueKind ReadValue(int depth, bool markPrivateInteger, bool enterInfoDictionary)
+        {
+            if (depth > MaximumDepth || ++_items > MaximumItems || Offset >= _bytes.Length)
+                throw new InvalidOperationException("Torrent bencode limits exceeded");
+            return _bytes[Offset] switch
+            {
+                (byte)'i' => ReadInteger(markPrivateInteger),
+                (byte)'l' => ReadList(depth),
+                (byte)'d' => ReadDictionary(depth, enterInfoDictionary),
+                >= (byte)'0' and <= (byte)'9' => ReadBytes(out _),
+                _ => throw new InvalidOperationException("Invalid bencode token"),
+            };
+        }
+
+        private ValueKind ReadInteger(bool markPrivateInteger)
+        {
+            Offset++;
+            var start = Offset;
+            if (Offset < _bytes.Length && _bytes[Offset] == '-')
+                Offset++;
+            while (Offset < _bytes.Length && _bytes[Offset] is >= (byte)'0' and <= (byte)'9')
+                Offset++;
+            if (Offset == start || Offset >= _bytes.Length || _bytes[Offset++] != 'e')
+                throw new InvalidOperationException("Invalid bencode integer");
+            var number = Encoding.ASCII.GetString(_bytes[start..(Offset - 1)]);
+            if (number is "-0" || number.StartsWith('0') && number.Length > 1 || number.StartsWith("-0") || !long.TryParse(number, out var value))
+                throw new InvalidOperationException("Invalid bencode integer");
+            if (markPrivateInteger)
+            {
+                if (value != 1)
+                    throw new InvalidOperationException("Private flag has an invalid value");
+                PrivateFlag = true;
+            }
+            return ValueKind.Integer;
+        }
+
+        private ValueKind ReadList(int depth)
+        {
+            Offset++;
+            while (Offset < _bytes.Length && _bytes[Offset] != 'e')
+                ReadValue(depth + 1, false, false);
+            if (Offset >= _bytes.Length)
+                throw new InvalidOperationException("Unterminated bencode list");
+            Offset++;
+            return ValueKind.List;
+        }
+
+        private ValueKind ReadDictionary(int depth, bool inInfo)
+        {
+            Offset++;
+            ReadOnlySpan<byte> previous = default;
+            while (Offset < _bytes.Length && _bytes[Offset] != 'e')
+            {
+                ReadBytes(out var key);
+                if (!previous.IsEmpty && previous.SequenceCompareTo(key) >= 0)
+                    throw new InvalidOperationException("Bencode dictionary keys are not canonical");
+                previous = key.ToArray();
+                var keyIsInfo = !inInfo && key.SequenceEqual("info"u8);
+                var keyIsPrivate = inInfo && key.SequenceEqual("private"u8);
+                var kind = ReadValue(depth + 1, keyIsPrivate, keyIsInfo);
+                if (keyIsPrivate && kind != ValueKind.Integer)
+                    throw new InvalidOperationException("Private flag must be an integer");
+            }
+            if (Offset >= _bytes.Length)
+                throw new InvalidOperationException("Unterminated bencode dictionary");
+            Offset++;
+            return ValueKind.Dictionary;
+        }
+
+        private ValueKind ReadBytes(out ReadOnlySpan<byte> value)
+        {
+            var start = Offset;
+            while (Offset < _bytes.Length && _bytes[Offset] is >= (byte)'0' and <= (byte)'9')
+                Offset++;
+            if (Offset == start || Offset >= _bytes.Length || _bytes[Offset++] != ':')
+                throw new InvalidOperationException("Invalid bencode string length");
+            var text = Encoding.ASCII.GetString(_bytes[start..(Offset - 1)]);
+            if (text.StartsWith('0') && text.Length > 1 || !int.TryParse(text, out var length) || length < 0 || length > MaximumBytes - Offset)
+                throw new InvalidOperationException("Invalid bencode string length");
+            value = _bytes.Slice(Offset, length);
+            Offset += length;
+            return ValueKind.Bytes;
+        }
+    }
+}
diff --git a/src/Jackett.Mini/CatalogPolicy.cs b/src/Jackett.Mini/CatalogPolicy.cs
new file mode 100644
index 000000000..6f9f74157
--- /dev/null
+++ b/src/Jackett.Mini/CatalogPolicy.cs
@@ -0,0 +1,80 @@
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Jackett.Mini;
+
+internal sealed record CatalogEntry(
+    string IndexerId,
+    string Name,
+    string Access,
+    string ContentClass,
+    bool RequiresCredentials,
+    bool RequiresExternalSolver,
+    string Eligibility,
+    string SourceKind,
+    string SourcePath,
+    string DefinitionSha256,
+    string? NativeType,
+    string[] Reasons);
+
+internal sealed record CatalogDocument(
+    int SchemaVersion,
+    string JackettVersion,
+    string JackettCommit,
+    string PolicySha256,
+    int[] AdultCategoryRange,
+    string[] EnabledIndexerIds,
+    CatalogEntry[] Entries);
+
+internal sealed class CatalogPolicy
+{
+    public const string Commit = "0cd8622b735922a909a128d8d6943bb8565a640f";
+    public const string ExpectedFileSha256 = "__WILDBUZZARD_CATALOG_SHA256__";
+    public const string Version = "v0.24.2360";
+    public CatalogDocument Document { get; }
+    public IReadOnlyDictionary<string, CatalogEntry> Enabled { get; }
+    public string FileSha256 { get; }
+
+    public CatalogPolicy(string path)
+    {
+        var bytes = File.ReadAllBytes(path);
+        FileSha256 = Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+        if (!CryptographicOperations.FixedTimeEquals(
+                Convert.FromHexString(ExpectedFileSha256),
+                Convert.FromHexString(FileSha256)))
+            throw new InvalidOperationException("Catalog digest differs from this executable");
+        Document = JsonSerializer.Deserialize<CatalogDocument>(bytes, JsonDefaults.Options)
+            ?? throw new InvalidOperationException("Catalog is empty");
+        if (Document.SchemaVersion != 1 || Document.JackettVersion != Version || Document.JackettCommit != Commit)
+            throw new InvalidOperationException("Catalog pin or schema is invalid");
+        if (Document.AdultCategoryRange is not [6000, 6999])
+            throw new InvalidOperationException("Adult category policy is invalid");
+        var entries = Document.Entries.ToDictionary(entry => entry.IndexerId, StringComparer.Ordinal);
+        if (entries.Count != Document.Entries.Length)
+            throw new InvalidOperationException("Catalog contains duplicate providers");
+        foreach (var entry in Document.Entries)
+        {
+            if (entry.Eligibility == "enabled-public" &&
+                (entry.Access != "public" || entry.ContentClass == "adult-only" || entry.RequiresCredentials || entry.RequiresExternalSolver))
+                throw new InvalidOperationException($"Ineligible provider is enabled: {entry.IndexerId}");
+        }
+        var enabled = Document.EnabledIndexerIds.Select(id => entries.TryGetValue(id, out var entry)
+                ? entry
+                : throw new InvalidOperationException($"Enabled provider is absent: {id}"))
+            .ToDictionary(entry => entry.IndexerId, StringComparer.Ordinal);
+        if (enabled.Values.Any(entry => entry.Eligibility != "enabled-public") ||
+            !enabled.Keys.Order().SequenceEqual(Document.Entries.Where(entry => entry.Eligibility == "enabled-public").Select(entry => entry.IndexerId).Order()))
+            throw new InvalidOperationException("Enabled provider set does not match eligibility decisions");
+        Enabled = enabled;
+    }
+
+}
+
+internal static class JsonDefaults
+{
+    public static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web)
+    {
+        PropertyNameCaseInsensitive = false,
+        UnmappedMemberHandling = System.Text.Json.Serialization.JsonUnmappedMemberHandling.Disallow,
+    };
+}
diff --git a/src/Jackett.Mini/PublicNetworkPolicy.cs b/src/Jackett.Mini/PublicNetworkPolicy.cs
new file mode 100644
index 000000000..fe8b23c47
--- /dev/null
+++ b/src/Jackett.Mini/PublicNetworkPolicy.cs
@@ -0,0 +1,96 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace Jackett.Mini;
+
+internal static class PublicNetworkPolicy
+{
+    private const string FixtureOrigin = "__WILDBUZZARD_FIXTURE_ORIGIN__";
+
+    public static async ValueTask<Stream> ConnectAsync(SocketsHttpConnectionContext context, CancellationToken cancellationToken)
+    {
+        var host = context.DnsEndPoint.Host;
+        var port = context.DnsEndPoint.Port;
+        var addresses = await ResolveAllowedAsync(host, port, cancellationToken);
+        Exception? lastError = null;
+        foreach (var address in addresses)
+        {
+            var socket = new Socket(address.AddressFamily, SocketType.Stream, ProtocolType.Tcp);
+            try
+            {
+                await socket.ConnectAsync(new IPEndPoint(address, context.DnsEndPoint.Port), cancellationToken);
+                if (socket.RemoteEndPoint is not IPEndPoint remote || !remote.Address.Equals(address) || !IsAllowed(remote.Address, host, port))
+                    throw new InvalidOperationException("Connected peer did not match the validated public address");
+                return new NetworkStream(socket, ownsSocket: true);
+            }
+            catch (Exception error)
+            {
+                socket.Dispose();
+                lastError = error;
+            }
+        }
+        throw new HttpRequestException("No validated public address accepted the connection", lastError);
+    }
+
+    public static async Task<IPAddress[]> ResolveAllowedAsync(string host, int port, CancellationToken cancellationToken)
+    {
+        var addresses = await Dns.GetHostAddressesAsync(host, cancellationToken);
+        if (addresses.Length == 0 || addresses.Any(address => !IsAllowed(address, host, port)))
+            throw new InvalidOperationException("Destination DNS did not resolve exclusively to public addresses");
+        return addresses;
+    }
+
+    private static bool IsAllowed(IPAddress address, string host, int port) =>
+        IsPublic(address) || (IsFixtureEndpoint(host, port) && IPAddress.IsLoopback(address));
+
+    private static bool IsFixtureEndpoint(string host, int port)
+    {
+        if (FixtureOrigin.Length == 0)
+            return false;
+        var fixture = new Uri(FixtureOrigin, UriKind.Absolute);
+        return fixture.Scheme == Uri.UriSchemeHttp &&
+               string.Equals(fixture.DnsSafeHost, host, StringComparison.OrdinalIgnoreCase) &&
+               fixture.Port == port;
+    }
+
+    public static bool IsPublic(IPAddress address)
+    {
+        if (address.IsIPv4MappedToIPv6)
+            address = address.MapToIPv4();
+        if (address.AddressFamily == AddressFamily.InterNetworkV6)
+        {
+            var bytes = address.GetAddressBytes();
+            return !IPAddress.IPv6Any.Equals(address) &&
+                   !IPAddress.IPv6Loopback.Equals(address) &&
+                   !address.IsIPv6LinkLocal &&
+                   !address.IsIPv6SiteLocal &&
+                   !address.IsIPv6Multicast &&
+                   (bytes[0] & 0xfe) != 0xfc &&
+                   !(bytes[0] == 0x20 && bytes[1] == 0x01 && bytes[2] == 0x0d && bytes[3] == 0xb8);
+        }
+        if (address.AddressFamily != AddressFamily.InterNetwork)
+            return false;
+        var value = address.GetAddressBytes();
+        return value[0] != 0 &&
+               value[0] != 10 &&
+               value[0] != 127 &&
+               !(value[0] == 100 && value[1] is >= 64 and <= 127) &&
+               !(value[0] == 169 && value[1] == 254) &&
+               !(value[0] == 172 && value[1] is >= 16 and <= 31) &&
+               !(value[0] == 192 && value[1] == 0 && value[2] == 0) &&
+               !(value[0] == 192 && value[1] == 0 && value[2] == 2) &&
+               !(value[0] == 192 && value[1] == 88 && value[2] == 99) &&
+               !(value[0] == 192 && value[1] == 168) &&
+               !(value[0] == 198 && value[1] is 18 or 19) &&
+               !(value[0] == 198 && value[1] == 51 && value[2] == 100) &&
+               !(value[0] == 203 && value[1] == 0 && value[2] == 113) &&
+               value[0] < 224;
+    }
+
+    public static async Task ValidateUriAsync(Uri uri, CancellationToken cancellationToken)
+    {
+        if (!uri.IsAbsoluteUri || uri.Scheme is not ("http" or "https") || !string.IsNullOrEmpty(uri.UserInfo))
+            throw new InvalidOperationException("Provider request URL is invalid");
+        await ResolveAllowedAsync(uri.DnsSafeHost, uri.Port, cancellationToken);
+    }
+}
diff --git a/src/Jackett.Mini/DirectWebClient.cs b/src/Jackett.Mini/DirectWebClient.cs
new file mode 100644
index 000000000..40ff4d8ba
--- /dev/null
+++ b/src/Jackett.Mini/DirectWebClient.cs
@@ -0,0 +1,318 @@
+using System.IO.Compression;
+using System.Net;
+using System.Net.Security;
+using System.Security.Cryptography.X509Certificates;
+using System.Text;
+using Jackett.Common.Models.Config;
+using Jackett.Common.Services.Interfaces;
+using Jackett.Common.Utils;
+using Jackett.Common.Utils.Clients;
+using NLog;
+using JackettWebClient = Jackett.Common.Utils.Clients.WebClient;
+using JackettWebRequest = Jackett.Common.Utils.Clients.WebRequest;
+
+namespace Jackett.Mini;
+
+internal sealed class DirectWebClient : JackettWebClient, IDisposable
+{
+    private const int MaximumResponseBytes = 4 * 1024 * 1024;
+    private readonly HttpClient _client;
+    private TimeSpan _timeout = TimeSpan.FromSeconds(15);
+
+    public DirectWebClient(IProcessService process, Logger logger, IConfigurationService configuration, ServerConfig serverConfig)
+        : base(process, logger, configuration, serverConfig)
+    {
+        var handler = new SocketsHttpHandler
+        {
+            AllowAutoRedirect = false,
+            AutomaticDecompression = DecompressionMethods.None,
+            ConnectCallback = PublicNetworkPolicy.ConnectAsync,
+            ConnectTimeout = TimeSpan.FromSeconds(10),
+            MaxConnectionsPerServer = 4,
+            SslOptions = { RemoteCertificateValidationCallback = ValidateCertificate },
+            UseCookies = false,
+            UseProxy = false,
+        };
+        _client = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(15) };
+    }
+
+    public override void SetTimeout(int seconds) => _timeout = TimeSpan.FromSeconds(Math.Clamp(seconds, 1, 15));
+
+    private static bool ValidateCertificate(
+        object sender,
+        X509Certificate? certificate,
+        X509Chain? chain,
+        SslPolicyErrors sslPolicyErrors)
+    {
+        if (sslPolicyErrors == SslPolicyErrors.None)
+            return true;
+        if (sender is not SslStream { TargetHostName: var host } || certificate is null)
+            return false;
+        return trustedCertificates.TryGetValue(certificate.GetCertHashString(), out var hosts) && hosts.Contains(host);
+    }
+
+    protected override async Task<WebResult> Run(JackettWebRequest webRequest)
+    {
+        var uri = new Uri(webRequest.Url);
+        var origin = uri;
+        var method = webRequest.Type == RequestType.POST ? HttpMethod.Post : HttpMethod.Get;
+        using var timeout = new CancellationTokenSource(_timeout);
+        var response = await SendWithPolicy(
+            _client,
+            (target, verb) => CreateRequest(webRequest, target, verb, SameOrigin(origin, target)),
+            uri,
+            method,
+            cancellationToken: timeout.Token);
+        using (response)
+        {
+            await using var input = await response.Content.ReadAsStreamAsync(timeout.Token);
+            var compressedBytes = await ReadBoundedAsync(input, "compressed", timeout.Token);
+            var contentBytes = await DecodeBoundedAsync(
+                compressedBytes,
+                response.Content.Headers.ContentEncoding,
+                timeout.Token);
+            if (IsExternalSolverChallenge(response, contentBytes))
+                throw new InvalidOperationException("Provider returned an external-solver challenge");
+            var result = new WebResult
+            {
+                ContentBytes = contentBytes,
+                Status = response.StatusCode,
+                RedirectingTo = response.Headers.Location?.ToString(),
+            };
+            foreach (var header in response.Headers)
+                result.Headers[header.Key] = header.Value.ToArray();
+            foreach (var header in response.Content.Headers)
+                if (!header.Key.Equals("Content-Encoding", StringComparison.OrdinalIgnoreCase) &&
+                    !header.Key.Equals("Content-Length", StringComparison.OrdinalIgnoreCase))
+                    result.Headers[header.Key] = header.Value.ToArray();
+            ValidatePotentialXml(result.ContentBytes, response.Content.Headers.ContentType?.MediaType);
+            if (response.Headers.TryGetValues("Set-Cookie", out var cookies))
+                result.Cookies = string.Join(" ", cookies.Select(cookie => cookie.Split(';', 2)[0] + ";"));
+            return result;
+        }
+    }
+
+    private static async Task<byte[]> ReadBoundedAsync(Stream input, string kind, CancellationToken cancellationToken)
+    {
+        using var output = new MemoryStream();
+        var buffer = new byte[64 * 1024];
+        while (true)
+        {
+            var count = await input.ReadAsync(buffer, cancellationToken);
+            if (count == 0)
+                return output.ToArray();
+            if (output.Length + count > MaximumResponseBytes)
+                throw new InvalidOperationException($"Provider {kind} response exceeded the byte limit");
+            output.Write(buffer, 0, count);
+        }
+    }
+
+    internal static bool IsExternalSolverChallenge(HttpResponseMessage response, byte[] bytes)
+    {
+        var protectedServer = response.Headers.Server.Any(item =>
+            item.Product is not null &&
+            (item.Product.Name.ToLowerInvariant() is "cloudflare" or "cloudflare-nginx" or "ddos-guard"));
+        if (!protectedServer)
+            return false;
+        var body = Encoding.UTF8.GetString(bytes);
+        if ((response.StatusCode is HttpStatusCode.ServiceUnavailable or HttpStatusCode.Forbidden) &&
+            (body.Contains("<title>Just a moment...</title>", StringComparison.Ordinal) ||
+             body.Contains("<title>Access denied</title>", StringComparison.Ordinal) ||
+             body.Contains("<title>Attention Required! | Cloudflare</title>", StringComparison.Ordinal) ||
+             body.Trim().Equals("error code: 1020", StringComparison.Ordinal) ||
+             body.Contains("<title>DDOS-GUARD</title>", StringComparison.OrdinalIgnoreCase)))
+            return true;
+        return string.Join(",", response.Headers.Vary).Equals("Accept-Encoding,User-Agent", StringComparison.Ordinal) &&
+               response.Content.Headers.ContentEncoding.Count == 0 &&
+               body.Contains("ddos", StringComparison.OrdinalIgnoreCase);
+    }
+
+    internal static async Task<byte[]> DecodeBoundedAsync(
+        byte[] bytes,
+        ICollection<string> contentEncodings,
+        CancellationToken cancellationToken)
+    {
+        if (contentEncodings.Count == 0)
+            return bytes;
+        if (contentEncodings.Count != 1)
+            throw new InvalidOperationException("Provider response used unsupported layered content encoding");
+        using var input = new MemoryStream(bytes, writable: false);
+        await using Stream decoded = contentEncodings.Single().ToLowerInvariant() switch
+        {
+            "br" => new BrotliStream(input, CompressionMode.Decompress),
+            "deflate" => new ZLibStream(input, CompressionMode.Decompress),
+            "gzip" => new GZipStream(input, CompressionMode.Decompress),
+            "identity" => input,
+            _ => throw new InvalidOperationException("Provider response used unsupported content encoding"),
+        };
+        return await ReadBoundedAsync(decoded, "decompressed", cancellationToken);
+    }
+
+    internal static void ValidatePotentialXml(byte[] bytes, string? mediaType)
+    {
+        if (!LooksLikeXml(bytes, mediaType))
+            return;
+        BoundedXmlValidator.Validate(bytes);
+    }
+
+    private static bool LooksLikeXml(byte[] bytes, string? mediaType)
+    {
+        if (mediaType?.Contains("xml", StringComparison.OrdinalIgnoreCase) is true)
+            return true;
+        if (mediaType?.Contains("html", StringComparison.OrdinalIgnoreCase) is true ||
+            mediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) is true)
+            return false;
+        var text = DecodeForXmlSniff(bytes);
+        var offset = 0;
+        while (true)
+        {
+            while (offset < text.Length && char.IsWhiteSpace(text[offset]))
+                offset++;
+            if (text.AsSpan(offset).StartsWith("<!--", StringComparison.Ordinal))
+            {
+                var end = text.IndexOf("-->", offset + 4, StringComparison.Ordinal);
+                if (end < 0)
+                    return false;
+                offset = end + 3;
+                continue;
+            }
+            if (text.AsSpan(offset).StartsWith("<?xml", StringComparison.Ordinal))
+                return true;
+            if (text.AsSpan(offset).StartsWith("<?", StringComparison.Ordinal))
+            {
+                var end = text.IndexOf("?>", offset + 2, StringComparison.Ordinal);
+                if (end < 0)
+                    return false;
+                offset = end + 2;
+                continue;
+            }
+            break;
+        }
+        if (offset >= text.Length || text[offset] != '<')
+            return false;
+        offset++;
+        var declaration = text.AsSpan(offset).StartsWith("!DOCTYPE", StringComparison.OrdinalIgnoreCase);
+        if (declaration)
+            offset += "!DOCTYPE".Length;
+        while (offset < text.Length && char.IsWhiteSpace(text[offset]))
+            offset++;
+        var start = offset;
+        while (offset < text.Length &&
+               !char.IsWhiteSpace(text[offset]) &&
+               text[offset] is not '>' and not '/')
+            offset++;
+        var name = text[start..offset];
+        var colon = name.LastIndexOf(':');
+        if (colon >= 0)
+            name = name[(colon + 1)..];
+        if (name.Equals("html", StringComparison.OrdinalIgnoreCase))
+            return false;
+        return declaration || name.Length > 0;
+    }
+
+    private static string DecodeForXmlSniff(byte[] bytes)
+    {
+        if (bytes.AsSpan().StartsWith(new byte[] { 0x00, 0x00, 0xFE, 0xFF }))
+            return new UTF32Encoding(bigEndian: true, byteOrderMark: true, throwOnInvalidCharacters: true)
+                .GetString(bytes, 4, bytes.Length - 4);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0xFF, 0xFE, 0x00, 0x00 }))
+            return new UTF32Encoding(bigEndian: false, byteOrderMark: true, throwOnInvalidCharacters: true)
+                .GetString(bytes, 4, bytes.Length - 4);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0xFE, 0xFF }))
+            return new UnicodeEncoding(bigEndian: true, byteOrderMark: true, throwOnInvalidBytes: true)
+                .GetString(bytes, 2, bytes.Length - 2);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0xFF, 0xFE }))
+            return new UnicodeEncoding(bigEndian: false, byteOrderMark: true, throwOnInvalidBytes: true)
+                .GetString(bytes, 2, bytes.Length - 2);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0xEF, 0xBB, 0xBF }))
+            return new UTF8Encoding(encoderShouldEmitUTF8Identifier: true, throwOnInvalidBytes: true)
+                .GetString(bytes, 3, bytes.Length - 3);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0x00, 0x00, 0x00, 0x3C }))
+            return new UTF32Encoding(bigEndian: true, byteOrderMark: false, throwOnInvalidCharacters: true)
+                .GetString(bytes);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0x3C, 0x00, 0x00, 0x00 }))
+            return new UTF32Encoding(bigEndian: false, byteOrderMark: false, throwOnInvalidCharacters: true)
+                .GetString(bytes);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0x00, 0x3C }))
+            return new UnicodeEncoding(bigEndian: true, byteOrderMark: false, throwOnInvalidBytes: true)
+                .GetString(bytes);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0x3C, 0x00 }))
+            return new UnicodeEncoding(bigEndian: false, byteOrderMark: false, throwOnInvalidBytes: true)
+                .GetString(bytes);
+        if (bytes.AsSpan().StartsWith(new byte[] { 0x4C, 0x6F, 0xA7, 0x94 }))
+            throw new InvalidOperationException("Provider XML used an unsupported EBCDIC encoding");
+        return new UTF8Encoding(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: false)
+            .GetString(bytes);
+    }
+
+    private static HttpRequestMessage CreateRequest(JackettWebRequest webRequest, Uri uri, HttpMethod method, bool includeSensitive)
+    {
+        var request = new HttpRequestMessage(method, uri);
+        foreach (var header in webRequest.Headers ?? new Dictionary<string, string>())
+        {
+            if (!header.Key.Equals("Content-Type", StringComparison.OrdinalIgnoreCase) &&
+                !header.Key.Equals("Host", StringComparison.OrdinalIgnoreCase) &&
+                (includeSensitive || !header.Key.Equals("Authorization", StringComparison.OrdinalIgnoreCase)) &&
+                (includeSensitive || !header.Key.Equals("Cookie", StringComparison.OrdinalIgnoreCase)))
+                request.Headers.TryAddWithoutValidation(header.Key, header.Value);
+        }
+        if (includeSensitive && !string.IsNullOrWhiteSpace(webRequest.Cookies))
+            request.Headers.TryAddWithoutValidation("Cookie", webRequest.Cookies);
+        if (request.Headers.UserAgent.Count == 0)
+            request.Headers.UserAgent.ParseAdd(webRequest.EmulateBrowser == true
+                ? BrowserUtil.ChromeUserAgent
+                : "Jackett/" + CatalogPolicy.Version);
+        if (!string.IsNullOrWhiteSpace(webRequest.Referer))
+            request.Headers.Referrer = new Uri(webRequest.Referer);
+        if (method == HttpMethod.Post && !string.IsNullOrEmpty(webRequest.RawBody))
+            request.Content = new StringContent(webRequest.RawBody, Encoding.UTF8, webRequest.Headers?.GetValueOrDefault("Content-Type") ?? "application/octet-stream");
+        else if (method == HttpMethod.Post && webRequest.PostData is not null)
+            request.Content = new FormUrlEncodedContent(webRequest.PostData);
+        return request;
+    }
+
+    private static bool SameOrigin(Uri left, Uri right) =>
+        left.Scheme == right.Scheme && left.IdnHost == right.IdnHost && left.Port == right.Port;
+
+    internal static async Task<HttpResponseMessage> SendWithPolicy(
+        HttpClient client,
+        Func<Uri, HttpMethod, HttpRequestMessage> createRequest,
+        Uri uri,
+        HttpMethod method,
+        Func<Uri, CancellationToken, Task>? validate = null,
+        CancellationToken cancellationToken = default)
+    {
+        validate ??= PublicNetworkPolicy.ValidateUriAsync;
+        for (var redirects = 0; redirects <= 5; redirects++)
+        {
+            await validate(uri, cancellationToken);
+            using var request = createRequest(uri, method);
+            var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
+            if (response.StatusCode == HttpStatusCode.TooManyRequests)
+            {
+                response.Dispose();
+                throw new HttpRequestException("Provider rate limited the request", null, HttpStatusCode.TooManyRequests);
+            }
+            if ((int)response.StatusCode is < 300 or > 399 || response.Headers.Location is null)
+                return response;
+            if (redirects == 5)
+            {
+                response.Dispose();
+                throw new InvalidOperationException("Provider response exceeded the redirect limit");
+            }
+            var redirected = new Uri(uri, response.Headers.Location);
+            if (uri.Scheme == "https" && redirected.Scheme != "https")
+            {
+                response.Dispose();
+                throw new InvalidOperationException("Provider redirect attempted to downgrade TLS");
+            }
+            uri = redirected;
+            if (response.StatusCode is HttpStatusCode.Moved or HttpStatusCode.Found or HttpStatusCode.SeeOther)
+                method = HttpMethod.Get;
+            response.Dispose();
+        }
+        throw new InvalidOperationException("Provider response was unavailable");
+    }
+
+    public void Dispose() => _client.Dispose();
+}
diff --git a/src/Jackett.Mini/SecuritySelfTest.cs b/src/Jackett.Mini/SecuritySelfTest.cs
new file mode 100644
index 000000000..0a2a67758
--- /dev/null
+++ b/src/Jackett.Mini/SecuritySelfTest.cs
@@ -0,0 +1,156 @@
+using System.IO.Compression;
+using System.Net;
+using System.Security.Authentication;
+using System.Text;
+using System.Xml;
+
+namespace Jackett.Mini;
+
+internal static class SecuritySelfTest
+{
+    public static async Task Run()
+    {
+        Assert(!PublicNetworkPolicy.IsPublic(IPAddress.Loopback), "loopback accepted");
+        Assert(!PublicNetworkPolicy.IsPublic(IPAddress.Parse("169.254.169.254")), "link-local accepted");
+        Assert(!PublicNetworkPolicy.IsPublic(IPAddress.Parse("fc00::1")), "unique-local accepted");
+        Assert(PublicNetworkPolicy.IsPublic(IPAddress.Parse("8.8.8.8")), "public address rejected");
+        await AssertThrows<HttpRequestException>(() => Send(new StaticHandler(_ => new HttpResponseMessage(HttpStatusCode.TooManyRequests))));
+        using var challenge = new HttpResponseMessage(HttpStatusCode.Forbidden) { Content = new StringContent("<title>Just a moment...</title>") };
+        challenge.Headers.Server.ParseAdd("cloudflare");
+        Assert(DirectWebClient.IsExternalSolverChallenge(challenge, Encoding.UTF8.GetBytes("<title>Just a moment...</title>")),
+            "external-solver challenge was not detected");
+        var redirects = 0;
+        await AssertThrows<InvalidOperationException>(() => Send(new StaticHandler(_ =>
+        {
+            redirects++;
+            return new HttpResponseMessage(HttpStatusCode.Found) { Headers = { Location = new Uri("/loop", UriKind.Relative) } };
+        })));
+        Assert(redirects == 6, "redirect limit was not exact");
+        using var stalled = new HttpClient(new StaticHandler(async (_, cancellationToken) =>
+        {
+            await Task.Delay(Timeout.InfiniteTimeSpan, cancellationToken);
+            return new HttpResponseMessage(HttpStatusCode.OK);
+        })) { Timeout = TimeSpan.FromMilliseconds(50) };
+        await AssertThrows<TaskCanceledException>(() => Send(stalled));
+        var tls = new HttpRequestException("TLS failed", new AuthenticationException("certificate rejected"));
+        await AssertThrows<HttpRequestException>(() => Send(new StaticHandler(_ => throw tls)));
+        DirectWebClient.ValidatePotentialXml(
+            Encoding.UTF8.GetBytes("<html><body><br></body></html>"),
+            "text/html");
+        DirectWebClient.ValidatePotentialXml(
+            Encoding.UTF8.GetBytes("{\"markup\":\"<rss>not XML\"}"),
+            "application/json");
+        AssertActionThrows<XmlException>(() => DirectWebClient.ValidatePotentialXml(
+            Encoding.UTF8.GetBytes("<!DOCTYPE rss [<!ENTITY x 'entity'>]><rss>&x;</rss>"),
+            "text/plain"));
+        await AssertCodec("gzip", stream => new GZipStream(stream, CompressionMode.Compress));
+        await AssertCodec("deflate", stream => new ZLibStream(stream, CompressionMode.Compress));
+        await AssertCodec("br", stream => new BrotliStream(stream, CompressionMode.Compress));
+        await AssertTaskThrows<InvalidDataException>(() =>
+            DirectWebClient.DecodeBoundedAsync(
+                new byte[] { 0x1F, 0x8B, 0, 0, 0, 0, 0, 0, 0, 0 },
+                new[] { "gzip" },
+                CancellationToken.None));
+        await AssertTaskThrows<InvalidOperationException>(() =>
+            DirectWebClient.DecodeBoundedAsync(new byte[] { 0 }, new[] { "gzip", "br" }, CancellationToken.None));
+        var deepBody = "<rss>" + string.Concat(Enumerable.Repeat("<node>", 70)) +
+            string.Concat(Enumerable.Repeat("</node>", 70)) + "</rss>";
+        var deepXml = "<?xml version=\"1.0\"?>" + deepBody;
+        foreach (var encoding in new Encoding[]
+        {
+            new UnicodeEncoding(false, true, true),
+            new UnicodeEncoding(true, true, true),
+            new UTF32Encoding(false, true, true),
+            new UTF32Encoding(true, true, true),
+        })
+        {
+            var encoded = encoding.GetBytes(deepXml);
+            AssertActionThrows<InvalidOperationException>(() =>
+                DirectWebClient.ValidatePotentialXml(encoded, "text/plain"));
+            AssertActionThrows<InvalidOperationException>(() =>
+                DirectWebClient.ValidatePotentialXml(encoding.GetPreamble().Concat(encoded).ToArray(), "text/plain"));
+        }
+        AssertActionThrows<InvalidOperationException>(() =>
+            DirectWebClient.ValidatePotentialXml(
+                Encoding.Latin1.GetBytes("<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>" + deepBody),
+                "text/plain"));
+    }
+
+    private static async Task AssertCodec(string name, Func<Stream, Stream> compressor)
+    {
+        var source = Encoding.UTF8.GetBytes("<?xml version=\"1.0\"?><rss><channel/></rss>");
+        using var output = new MemoryStream();
+        using (var stream = compressor(output))
+            stream.Write(source);
+        var decoded = await DirectWebClient.DecodeBoundedAsync(
+            output.ToArray(), new[] { name }, CancellationToken.None);
+        Assert(decoded.SequenceEqual(source), $"{name} response decoding failed");
+    }
+
+    private static Task<HttpResponseMessage> Send(HttpMessageHandler handler) => Send(new HttpClient(handler));
+
+    private static Task<HttpResponseMessage> Send(HttpClient client) => DirectWebClient.SendWithPolicy(
+        client,
+        (uri, method) => new HttpRequestMessage(method, uri),
+        new Uri("https://example.invalid/start"),
+        HttpMethod.Get,
+        (_, _) => Task.CompletedTask);
+
+    private static async Task AssertThrows<T>(Func<Task<HttpResponseMessage>> action) where T : Exception
+    {
+        try
+        {
+            using var response = await action();
+        }
+        catch (T)
+        {
+            return;
+        }
+        throw new InvalidOperationException($"Expected {typeof(T).Name}");
+    }
+
+    private static void AssertActionThrows<T>(Action action) where T : Exception
+    {
+        try
+        {
+            action();
+        }
+        catch (T)
+        {
+            return;
+        }
+        throw new InvalidOperationException($"Expected {typeof(T).Name}");
+    }
+
+    private static async Task AssertTaskThrows<T>(Func<Task> action) where T : Exception
+    {
+        try
+        {
+            await action();
+        }
+        catch (T)
+        {
+            return;
+        }
+        throw new InvalidOperationException($"Expected {typeof(T).Name}");
+    }
+
+    private static void Assert(bool condition, string message)
+    {
+        if (!condition)
+            throw new InvalidOperationException(message);
+    }
+
+    private sealed class StaticHandler : HttpMessageHandler
+    {
+        private readonly Func<HttpRequestMessage, CancellationToken, Task<HttpResponseMessage>> _send;
+
+        public StaticHandler(Func<HttpRequestMessage, HttpResponseMessage> send)
+            : this((request, _) => Task.FromResult(send(request))) { }
+
+        public StaticHandler(Func<HttpRequestMessage, CancellationToken, Task<HttpResponseMessage>> send) => _send = send;
+
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken) =>
+            _send(request, cancellationToken);
+    }
+}
diff --git a/src/Jackett.Mini/DiscoveryService.cs b/src/Jackett.Mini/DiscoveryService.cs
new file mode 100644
index 000000000..792c7f857
--- /dev/null
+++ b/src/Jackett.Mini/DiscoveryService.cs
@@ -0,0 +1,233 @@
+using System.Diagnostics;
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using Jackett.Common.Indexers;
+using Jackett.Common.Models;
+using Microsoft.AspNetCore.WebUtilities;
+
+namespace Jackett.Mini;
+
+internal sealed class DiscoveryService
+{
+    private readonly IndexerRegistry _registry;
+    private readonly ResultStore _store;
+
+    public DiscoveryService(IndexerRegistry registry, ResultStore store)
+    {
+        _registry = registry;
+        _store = store;
+    }
+
+    public object Sources() => new
+    {
+        immutable = true,
+        sources = _registry.Sources.OrderBy(source => source.Entry.IndexerId, StringComparer.Ordinal).Select(source => new
+        {
+            id = source.Entry.IndexerId,
+            name = Clean(source.Entry.Name, 160),
+            state = source.State,
+            access = "public",
+            contentClass = source.Entry.ContentClass,
+            reasons = source.Entry.Reasons,
+        }),
+    };
+
+    public async Task<SearchResponse> Search(SearchRequest request, CancellationToken cancellationToken)
+    {
+        var queryText = request.Query?.Trim() ?? string.Empty;
+        if (queryText.Length is < 1 or > 256 || queryText.Any(char.IsControl))
+            throw new BadHttpRequestException("Query must contain 1 through 256 non-control characters");
+        if (request.Limit is < 1 or > 200)
+            throw new BadHttpRequestException("Limit must be between 1 and 200");
+        var selected = request.SourceIds is null
+            ? _registry.Sources.OrderBy(source => source.Entry.IndexerId, StringComparer.Ordinal).ToArray()
+            : SelectSources(request.SourceIds);
+        var searchId = WebEncoders.Base64UrlEncode(RandomNumberGenerator.GetBytes(24));
+        using var overall = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        overall.CancelAfter(TimeSpan.FromSeconds(30));
+        using var permits = new SemaphoreSlim(4, 4);
+        var tasks = selected.Select(source => SearchSource(source, queryText, request.Limit, permits, overall.Token)).ToArray();
+        var outcomes = await Task.WhenAll(tasks);
+        var statuses = outcomes.Select(outcome => outcome.Status).ToArray();
+        var mapped = new List<SearchResult>();
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var outcome in outcomes)
+        {
+            if (outcome.Source.Indexer is null)
+                continue;
+            foreach (var release in outcome.Releases)
+            {
+                var categories = (release.Category ?? Array.Empty<int>()).Distinct().Order().ToArray();
+                var acquisition = TryMagnet(release, out _) ? "magnet" : ResolveUri(release) is not null ? "torrent" : null;
+                if (acquisition is null)
+                    continue;
+                var deduplicationKey = DeduplicationKey(outcome.Source.Entry.IndexerId, release);
+                if (deduplicationKey is not null && !seen.Add(deduplicationKey))
+                    continue;
+                var id = _store.Add(searchId, outcome.Source.Indexer, release);
+                long? leechers = release.Peers.HasValue && release.Seeders.HasValue
+                    ? Math.Max(0, release.Peers.Value - release.Seeders.Value)
+                    : null;
+                mapped.Add(new SearchResult(
+                    id,
+                    outcome.Source.Entry.IndexerId,
+                    Clean(outcome.Source.Entry.Name, 160),
+                    Clean(release.Title, 512),
+                    release.Size is >= 0 ? release.Size : null,
+                    release.Seeders is >= 0 ? release.Seeders : null,
+                    leechers,
+                    release.PublishDate == default ? null : new DateTimeOffset(release.PublishDate.ToUniversalTime()),
+                    categories,
+                    "public",
+                    acquisition));
+            }
+        }
+        var results = mapped
+            .OrderBy(result => result.Seeders.HasValue ? 0 : 1)
+            .ThenByDescending(result => result.Seeders)
+            .ThenBy(result => result.ProviderId, StringComparer.Ordinal)
+            .ThenBy(result => result.Name, StringComparer.OrdinalIgnoreCase)
+            .ThenBy(result => result.ResultId, StringComparer.Ordinal)
+            .Take(request.Limit)
+            .ToArray();
+        return new SearchResponse(searchId, statuses.Any(status => status.State != "ok"), statuses, results);
+    }
+
+    public async Task<ResolutionResponse?> Resolve(string id, CancellationToken cancellationToken)
+    {
+        if (id.Length != 32 || id.Any(c => !char.IsAsciiLetterOrDigit(c) && c is not '-' and not '_') || !_store.TryTake(id, out var stored) || stored is null)
+            return null;
+        if (TryMagnet(stored.Release, out var magnet))
+            return new ResolutionResponse("magnet", magnet, null, null);
+        var uri = ResolveUri(stored.Release) ?? throw new InvalidOperationException("Stored result has no acquisition target");
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        timeout.CancelAfter(TimeSpan.FromSeconds(15));
+        var bytes = await stored.Indexer.Download(uri).WaitAsync(timeout.Token);
+        BencodeValidator.ValidatePublicTorrent(bytes);
+        return new ResolutionResponse("torrent", null, Convert.ToBase64String(bytes), bytes.Length);
+    }
+
+    private SourceState[] SelectSources(string[] ids)
+    {
+        if (ids.Length is < 1 or > 100 ||
+            ids.Any(id => string.IsNullOrWhiteSpace(id) || id.Length > 128 || id.Any(char.IsControl)) ||
+            ids.Distinct(StringComparer.Ordinal).Count() != ids.Length)
+            throw new BadHttpRequestException("Source ids must be a non-empty unique array");
+        try
+        {
+            return ids.Select(_registry.Get).ToArray();
+        }
+        catch (KeyNotFoundException)
+        {
+            throw new BadHttpRequestException("A source is not in the immutable eligible catalog");
+        }
+    }
+
+    private static async Task<SearchOutcome> SearchSource(SourceState source, string queryText, int limit, SemaphoreSlim permits, CancellationToken cancellationToken)
+    {
+        var timer = Stopwatch.StartNew();
+        if (source.Indexer is null)
+            return new SearchOutcome(source, new ProviderStatus(source.Entry.IndexerId, "unavailable", 0), Array.Empty<ReleaseInfo>());
+        try
+        {
+            await permits.WaitAsync(cancellationToken);
+        }
+        catch (OperationCanceledException)
+        {
+            return new SearchOutcome(source, new ProviderStatus(source.Entry.IndexerId, "timeout", timer.ElapsedMilliseconds), Array.Empty<ReleaseInfo>());
+        }
+        try
+        {
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            timeout.CancelAfter(TimeSpan.FromSeconds(15));
+            var query = new TorznabQuery
+            {
+                QueryType = "search",
+                SearchTerm = queryText,
+                Categories = Array.Empty<int>(),
+                Limit = limit,
+                Offset = 0,
+                Cache = true,
+                InteractiveSearch = false,
+            };
+            if (!source.Indexer.CanHandleQuery(query))
+                return new SearchOutcome(source, new ProviderStatus(source.Entry.IndexerId, "unsupported", timer.ElapsedMilliseconds), Array.Empty<ReleaseInfo>());
+            var result = await source.Indexer.ResultsForQuery(query).WaitAsync(timeout.Token);
+            return new SearchOutcome(source, new ProviderStatus(source.Entry.IndexerId, "ok", timer.ElapsedMilliseconds), result.Releases.ToArray());
+        }
+        catch (OperationCanceledException)
+        {
+            return new SearchOutcome(source, new ProviderStatus(source.Entry.IndexerId, "timeout", timer.ElapsedMilliseconds), Array.Empty<ReleaseInfo>());
+        }
+        catch
+        {
+            return new SearchOutcome(source, new ProviderStatus(source.Entry.IndexerId, "error", timer.ElapsedMilliseconds), Array.Empty<ReleaseInfo>());
+        }
+        finally
+        {
+            permits.Release();
+        }
+    }
+
+    private static Uri? ResolveUri(ReleaseInfo release) => release.Link ?? release.Guid ?? release.Details;
+
+    private static string? DeduplicationKey(string providerId, ReleaseInfo release)
+    {
+        if (TryInfoHash(release, out var hash))
+            return "btih:" + hash;
+        return release.Guid is null ? null : $"guid:{providerId}:{release.Guid.AbsoluteUri}";
+    }
+
+    private static bool TryInfoHash(ReleaseInfo release, out string? hash)
+    {
+        hash = release.InfoHash;
+        if (string.IsNullOrWhiteSpace(hash) && release.MagnetUri is not null)
+        {
+            var match = System.Text.RegularExpressions.Regex.Match(
+                release.MagnetUri.OriginalString,
+                @"(?:^|[?&])xt=urn:btih:([A-Fa-f0-9]{40}|[A-Za-z2-7]{32})(?:&|$)",
+                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
+            if (match.Success)
+                hash = match.Groups[1].Value;
+        }
+        if (string.IsNullOrWhiteSpace(hash) || !System.Text.RegularExpressions.Regex.IsMatch(hash, @"^(?:[A-Fa-f0-9]{40}|[A-Za-z2-7]{32})$"))
+        {
+            hash = null;
+            return false;
+        }
+        hash = hash.ToUpperInvariant();
+        return true;
+    }
+
+    private static bool TryMagnet(ReleaseInfo release, out string? magnet)
+    {
+        if (!TryInfoHash(release, out var hash))
+        {
+            magnet = null;
+            return false;
+        }
+        magnet = "magnet:?xt=urn:btih:" + hash;
+        var title = Clean(release.Title, 256);
+        if (title.Length > 0)
+            magnet += "&dn=" + Uri.EscapeDataString(title);
+        return true;
+    }
+
+    private static string Clean(string? value, int maximum)
+    {
+        if (string.IsNullOrEmpty(value))
+            return string.Empty;
+        var builder = new StringBuilder(Math.Min(value.Length, maximum));
+        foreach (var character in value.Normalize(NormalizationForm.FormC))
+        {
+            if (!char.IsControl(character) && char.GetUnicodeCategory(character) != UnicodeCategory.Format)
+                builder.Append(character);
+            if (builder.Length == maximum)
+                break;
+        }
+        return builder.ToString();
+    }
+
+    private sealed record SearchOutcome(SourceState Source, ProviderStatus Status, ReleaseInfo[] Releases);
+}
