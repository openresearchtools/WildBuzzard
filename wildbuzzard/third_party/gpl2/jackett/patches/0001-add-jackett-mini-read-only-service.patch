index 000000000..35f3ad3df
--- /dev/null
+++ b/src/Jackett.Mini/ResultStore.cs
@@ -0,0 +1,54 @@
+using System.Security.Cryptography;
+using Jackett.Common.Indexers;
+using Jackett.Common.Models;
+using Microsoft.AspNetCore.WebUtilities;
+
+namespace Jackett.Mini;
+
+internal sealed record StoredResult(string SearchId, IWebIndexer Indexer, ReleaseInfo Release, DateTimeOffset ExpiresAt);
+
+internal sealed class ResultStore
+{
+    private readonly object _gate = new();
+    private readonly Dictionary<string, StoredResult> _results = new(StringComparer.Ordinal);
+    private const int MaximumResults = 2000;
+
+    public string Add(string searchId, IWebIndexer indexer, ReleaseInfo release)
+    {
+        lock (_gate)
+        {
+            Prune();
+            while (_results.Count >= MaximumResults)
+                _results.Remove(_results.MinBy(pair => pair.Value.ExpiresAt).Key);
+            string id;
+            do
+            {
+                id = WebEncoders.Base64UrlEncode(RandomNumberGenerator.GetBytes(24));
+            } while (_results.ContainsKey(id));
+            _results.Add(id, new StoredResult(searchId, indexer, release, DateTimeOffset.UtcNow.AddMinutes(10)));
+            return id;
+        }
+    }
+
+    public bool TryTake(string id, out StoredResult? result)
+    {
+        lock (_gate)
+        {
+            Prune();
+            if (_results.Remove(id, out var found))
+            {
+                result = found;
+                return true;
+            }
+            result = null;
+            return false;
+        }
+    }
+
+    private void Prune()
+    {
+        var now = DateTimeOffset.UtcNow;
+        foreach (var id in _results.Where(pair => pair.Value.ExpiresAt <= now).Select(pair => pair.Key).ToArray())
+            _results.Remove(id);
+    }
+}
