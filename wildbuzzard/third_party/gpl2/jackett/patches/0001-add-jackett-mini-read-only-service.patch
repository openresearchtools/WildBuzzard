+
+internal sealed class ImmutableIndexerConfigurationService : IIndexerConfigurationService
+{
+    public void Load(IIndexer indexer)
+    {
+    }
+
+    public void Save(IIndexer indexer, JToken config) => throw new InvalidOperationException("Provider configuration is immutable");
+    public void Delete(IIndexer indexer) => throw new InvalidOperationException("Provider configuration is immutable");
+    public string GetIndexerConfigFilePath(string indexerId) => throw new InvalidOperationException("Provider configuration files do not exist");
