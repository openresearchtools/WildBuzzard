DIRS += [
    "components",
    "extensions/agent-sidebar",
    "extensions/common",
    "themes",
]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

# This file is intentionally loaded after browser/app/profile/firefox.js.
# WildBuzzard policy therefore overrides inherited vendor defaults without
# rewriting the upstream ESR preference file on every rebase.
JS_PREFERENCE_PP_FILES += [
    "app/profile/00-general.js",
    "app/profile/02-privacy.js",
    "app/profile/03-features.js",
    "app/profile/05-treetabs.js",
]

JS_PREFERENCE_FILES += ["app/profile/99-wildbuzzard.js"]
