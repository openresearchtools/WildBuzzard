XPCOM_MANIFESTS += ["components.conf"]

EXTRA_JS_MODULES += [
    "AboutTorrents.sys.mjs",
    "MagnetProtocolHandler.sys.mjs",
    "QBittorrentProtocolHandler.sys.mjs",
    "QBittorrentRuntime.sys.mjs",
    "QBittorrentSearchBridge.sys.mjs",
    "QBittorrentUDSTransport.sys.mjs",
    "QBittorrentWebBridge.sys.mjs",
    "QBittorrentWebUIChild.sys.mjs",
    "QBittorrentWebUIParent.sys.mjs",
    "TorrentContentHandler.sys.mjs",
    "TorrentDiscoveryManager.sys.mjs",
    "TorrentManager.sys.mjs",
]

FINAL_TARGET_FILES.modules += [
    "content/torrent-bootstrap.html",
]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]
XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]

FINAL_LIBRARY = "xul"
