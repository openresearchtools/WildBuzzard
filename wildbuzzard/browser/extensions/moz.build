DIRS += [
    "common",
    "torrent-search",
    "web-search",
]

GENERATED_FILES += ["SOURCES.lock.json"]
validated_sources = GENERATED_FILES["SOURCES.lock.json"]
validated_sources.script = (
    "../../scripts/sync_builtin_search_extensions.py:generate_build_lock"
)
validated_sources.force = True

FINAL_TARGET_FILES.chrome.browser["builtin-addons"] += [
    "!SOURCES.lock.json",
]
