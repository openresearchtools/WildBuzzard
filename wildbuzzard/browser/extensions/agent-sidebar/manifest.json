{
  "manifest_version": 2,
  "name": "Agent Runtime",
  "description": "Starts WildBuzzard's persistent bundled Agent runtime.",
  "version": "0.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "wildbuzzard-agent@internal",
      "strict_min_version": "153.0"
    }
  },
  "experiment_apis": {
    "wildbuzzardAgent": {
      "schema": "experiment-apis/wildbuzzardAgent.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiment-apis/wildbuzzardAgent.js",
        "paths": [["wildbuzzardAgent"]]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["tabs"]
}
