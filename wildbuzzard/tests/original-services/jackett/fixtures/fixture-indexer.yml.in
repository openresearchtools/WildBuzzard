---
# SPDX-License-Identifier: AGPL-3.0-or-later
id: __INDEXER_ID__
name: __INDEXER_NAME__
description: Deterministic local tracker used only by the original-service comparator
language: en-US
type: public
encoding: UTF-8
links:
  - __FIXTURE_ORIGIN__/

caps:
  categorymappings:
    - {id: safe, cat: Movies, desc: Safe fixture}
    - {id: adult, cat: XXX, desc: Adult fixture}

  modes:
    search: [q]

settings: []

search:
  paths:
    - path: "search?q={{ .Keywords }}"
      response:
        type: json

  rows:
    selector: items

  fields:
    category:
      selector: category
    title:
      selector: title
    details:
      selector: details
    download:
      selector: download
      optional: true
    infohash:
      selector: infoHash
      optional: true
    date:
      selector: published
    size:
      selector: size
    seeders:
      selector: seeders
    leechers:
      selector: leechers
    downloadvolumefactor:
      text: 0
    uploadvolumefactor:
      text: 1
