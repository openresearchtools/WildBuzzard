---
# SPDX-License-Identifier: AGPL-3.0-or-later
id: __INDEXER_ID__
name: __INDEXER_NAME__
description: Deterministic adversarial tracker used only by the pristine Jackett oracle
language: en-US
type: public
encoding: UTF-8
links:
  - __FIXTURE_ORIGIN__/

caps:
  categorymappings:
    - {id: safe, cat: Movies, desc: Safe fixture}
    - {id: adult6000, cat: XXX, desc: Adult 6000}
    - {id: adult6010, cat: XXX/DVD, desc: Adult 6010}
    - {id: adult6020, cat: XXX/WMV, desc: Adult 6020}
    - {id: adult6030, cat: XXX/XviD, desc: Adult 6030}
    - {id: adult6040, cat: XXX/x264, desc: Adult 6040}
    - {id: adult6045, cat: XXX/UHD, desc: Adult 6045}
    - {id: adult6050, cat: XXX/Pack, desc: Adult 6050}
    - {id: adult6060, cat: XXX/ImageSet, desc: Adult 6060}
    - {id: adult6070, cat: XXX/Other, desc: Adult 6070}
    - {id: adult6080, cat: XXX/SD, desc: Adult 6080}
    - {id: adult6090, cat: XXX/WEB-DL, desc: Adult 6090}
    - {id: generic, cat: Other, desc: Generic fixture}

  modes:
    search: [q]
    movie-search: [q]

settings: []

search:
  paths:
    - path: "oracle?source=__FIXTURE_SOURCE__&q={{ .Keywords }}"
      followredirect: true
      response:
        type: xml

  rows:
    selector: rss > channel > item

  fields:
    category:
      selector: trackerCategory
      optional: true
    category|append:
      selector: trackerCategory2
      optional: true
    title:
      selector: title
    details:
      selector: details
    download:
      selector: enclosure
      attribute: url
      optional: true
    infohash:
      selector: infoHash
      optional: true
    date:
      selector: published
    size:
      selector: size
      optional: true
    seeders:
      selector: seeders
      optional: true
    leechers:
      selector: leechers
      optional: true
    downloadvolumefactor:
      text: 0
    uploadvolumefactor:
      text: 1
