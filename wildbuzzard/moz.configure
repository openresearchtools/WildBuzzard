option(
    "--with-wildbuzzard-arti",
    nargs=1,
    help="Path to the Arti binary bundled with WildBuzzard",
)


@depends("--with-wildbuzzard-arti")
@imports("os")
def wildbuzzard_arti(value):
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Arti at {path}")
    return path


