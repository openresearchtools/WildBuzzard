# Keep Firefox in the user-agent for website compatibility while giving the
# installed application, profile, and package their own WildBuzzard identity.
imply_option("MOZ_APP_UA_NAME", "Firefox")
imply_option("MOZ_APP_REMOTINGNAME", "org.wildbuzzard.WildBuzzard")
imply_option("MOZ_TELEMETRY_REPORTING", False)
imply_option("--with-app-basename", "WildBuzzard")
imply_option("--with-distribution-id", "org.wildbuzzard")
imply_option("--enable-system-extension-dirs", False)
imply_option("--enable-crashreporter", False)
set_define("MOZ_WILDBUZZARD", True)

option(
    "--with-wildbuzzard-tor",
    nargs=1,
    help="Path to the Tor binary bundled with WildBuzzard",
)


@depends("--with-wildbuzzard-tor")
@imports("os")
def wildbuzzard_tor(value):
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Tor at {path}")
    return path


set_config("WILDBUZZARD_TOR", wildbuzzard_tor)

option(
    "--with-wildbuzzard-tor-config",
    nargs=1,
    help="Path to the metadata for the Tor binary bundled with WildBuzzard",
)


@depends("--with-wildbuzzard-tor-config", wildbuzzard_tor)
@imports("os")
def wildbuzzard_tor_config(value, binary):
    if bool(value) != bool(binary):
        die("The Tor binary and metadata must be configured together")
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Tor metadata at {path}")
    return path


set_config("WILDBUZZARD_TOR_CONFIG", wildbuzzard_tor_config)

option(
    "--with-wildbuzzard-tor-provenance",
    nargs=1,
    help="Path to the pinned Tor source binding and license provenance ZIP",
)


@depends(
    "--with-wildbuzzard-tor-provenance",
    wildbuzzard_tor,
    wildbuzzard_tor_config,
    build_environment.topsrcdir,
)
@imports("os")
@imports("sys")
def wildbuzzard_tor_provenance(value, binary, config, topsrcdir):
    if bool(value) != bool(binary and config):
        die("The Tor binary, metadata, and provenance must be configured together")
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Tor provenance at {path}")
    validator = os.path.join(
        topsrcdir, "wildbuzzard", "scripts", "tor-runtime-provenance.py"
    )
    inventory = os.path.join(
        topsrcdir,
        "wildbuzzard",
        "third_party",
        "tor-notices",
        "THIRD-PARTY.json",
    )
    pin = os.path.join(
        topsrcdir,
        "wildbuzzard",
        "third_party",
        "tor.toml",
    )
    check_cmd_output(
        sys.executable,
        "-I",
        "-B",
        validator,
        "validate",
        "--binary",
        binary,
        "--pin-config",
        pin,
        "--installed-config",
        config,
        "--provenance",
        path,
        "--inventory",
        inventory,
        onerror=lambda: die("Tor runtime provenance does not match the release pin"),
    )
    return path


set_config("WILDBUZZARD_TOR_PROVENANCE", wildbuzzard_tor_provenance)


@depends(wildbuzzard_tor, wildbuzzard_tor_config, wildbuzzard_tor_provenance)
def wildbuzzard_has_tor(binary, config, provenance):
    return bool(binary and config and provenance)


set_define("WILDBUZZARD_TOR_RUNTIME", wildbuzzard_has_tor)
