# Keep Firefox in the user-agent for website compatibility while giving the
# installed application, profile, and package their own WildBuzzard identity.
imply_option("MOZ_APP_UA_NAME", "Firefox")
imply_option("MOZ_APP_REMOTINGNAME", "org.wildbuzzard.WildBuzzard")
imply_option("MOZ_TELEMETRY_REPORTING", False)
imply_option("--with-app-basename", "WildBuzzard")
imply_option("--with-distribution-id", "org.wildbuzzard")
imply_option("--enable-system-extension-dirs", False)
imply_option("--enable-crashreporter", False)
set_define("MOZ_WILDBUZZARD", True)

option(
    "--with-wildbuzzard-arti",
    nargs=1,
    help="Path to the Arti binary bundled with WildBuzzard",
)


@depends("--with-wildbuzzard-arti")
@imports("os")
def wildbuzzard_arti(value):
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Arti at {path}")
    return path


set_config("WILDBUZZARD_ARTI", wildbuzzard_arti)

option(
    "--with-wildbuzzard-arti-config",
    nargs=1,
    help="Path to the metadata for the Arti binary bundled with WildBuzzard",
)


@depends("--with-wildbuzzard-arti-config", wildbuzzard_arti)
@imports("os")
def wildbuzzard_arti_config(value, binary):
    if bool(value) != bool(binary):
        die("The Arti binary and metadata must be configured together")
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Arti metadata at {path}")
    return path


set_config("WILDBUZZARD_ARTI_CONFIG", wildbuzzard_arti_config)

option(
    "--with-wildbuzzard-arti-provenance",
    nargs=1,
    help="Path to the pinned Arti SBOM, source binding, and license provenance ZIP",
)


@depends(
    "--with-wildbuzzard-arti-provenance",
    wildbuzzard_arti,
    wildbuzzard_arti_config,
    build_environment.topsrcdir,
)
@imports("os")
@imports("sys")
def wildbuzzard_arti_provenance(value, binary, config, topsrcdir):
    if bool(value) != bool(binary and config):
        die("The Arti binary, metadata, and provenance must be configured together")
    if not value:
        return
    path = os.path.abspath(value[0])
    if not os.path.isfile(path):
        die(f"Cannot find Arti provenance at {path}")
    validator = os.path.join(
        topsrcdir, "wildbuzzard", "scripts", "arti-runtime-provenance.py"
    )
    inventory = os.path.join(
        topsrcdir,
        "wildbuzzard",
        "third_party",
        "arti-crates",
        "THIRD-PARTY.json",
    )
    check_cmd_output(
        sys.executable,
        "-I",
        "-B",
        validator,
        "validate",
        "--binary",
        binary,
        "--pin-config",
        config,
        "--installed-config",
        config,
        "--provenance",
        path,
        "--inventory",
        inventory,
        onerror=lambda: die("Arti runtime provenance does not match the release pin"),
    )
    return path


set_config("WILDBUZZARD_ARTI_PROVENANCE", wildbuzzard_arti_provenance)


@depends(wildbuzzard_arti, wildbuzzard_arti_config, wildbuzzard_arti_provenance)
def wildbuzzard_has_arti(binary, config, provenance):
    return bool(binary and config and provenance)


set_define("WILDBUZZARD_ARTI_RUNTIME", wildbuzzard_has_arti)
