FROM docker.io/library/ubuntu@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea

ARG BUILDER_UID=1000
ARG BUILDER_GID=1000
ARG NODE_VERSION=22.23.2
ARG NODE_SHA256=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
ARG DOTNET_VERSION=9.0.304
ARG DOTNET_SHA512=b087828d595d0c6886bf652c69f3910303f455accb1ac956403f795080c55caf59732f3be0e31fc744aff13591a92e1efeb646ef3ca6165ed17a3cd12a67b229
ARG RUSTUP_VERSION=1.23.1
ARG RUSTUP_SHA256=ed7773edaf1d289656bdec2aacad12413b38ad0193fff54b2231f5140a4b07c5
ARG RUST_TOOLCHAIN=1.96.0
ARG BOOST_VERSION=1.88.0
ARG BOOST_SHA256=46d9d2c06637b219270877c9e16155cbd015b6dc84349af064c088e9b5b12f7b
ARG AQTINSTALL_VERSION=3.3.0
ARG QT_TOOLS_VERSION=6.10.2
ARG UV_VERSION=0.8.17
ARG APPIMAGETOOL_SHA256=b90f4a8b18967545fda78a445b27680a1642f1ef9488ced28b65398f2be7add2

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    DOTNET_ROOT=/opt/dotnet \
    RUSTUP_HOME=/home/builder/.rustup \
    PATH=/home/builder/.local/bin:/home/builder/.cargo/bin:/opt/dotnet:/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    acl \
    appstream \
    asciidoc \
    autoconf \
    automake \
    bash-completion \
    binutils \
    bison \
    build-essential \
    bzip2 \
    ca-certificates \
    ccache \
    chrpath \
    clang \
    clang-format \
    clang-tidy \
    clang-tools \
    cmake \
    coreutils \
    cpio \
    curl \
    dbus-x11 \
    debhelper \
    desktop-file-utils \
    devscripts \
    diffutils \
    dpkg-dev \
    elfutils \
    equivs \
    fakeroot \
    file \
    findutils \
    flex \
    fonts-dejavu \
    fonts-liberation \
    fuse3 \
    g++ \
    g++-multilib \
    gawk \
    gcc \
    gcc-multilib \
    gdb \
    gettext \
    git \
    git-lfs \
    gnupg \
    gperf \
    jq \
    less \
    libasound2-dev \
    libboost-all-dev \
    libbz2-dev \
    libc6-dev-i386 \
    libcurl4-openssl-dev \
    libdbus-glib-1-dev \
    libdrm-dev \
    libegl1-mesa-dev \
    libevent-dev \
    libexpat1-dev \
    libffi-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libfuse2 \
    libgdbm-compat-dev \
    libgdbm-dev \
    libgl1-mesa-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libicu-dev \
    liblzma-dev \
    libncurses-dev \
    libnss3-dev \
    libpci-dev \
    libpulse-dev \
    libqt6sql6-sqlite \
    libqt6svg6-dev \
    libreadline-dev \
    libsqlite3-dev \
    libssl-dev \
    libtool \
    libudev-dev \
    libwayland-dev \
    libx11-xcb-dev \
    libxcomposite-dev \
    libxcursor-dev \
    libxdamage-dev \
    libxext-dev \
    libxfixes-dev \
    libxi-dev \
    libxinerama-dev \
    libxkbcommon-dev \
    libxml2-dev \
    libxrandr-dev \
    libxrender-dev \
    libxslt1-dev \
    libxss-dev \
    libxt-dev \
    libyaml-dev \
    libzstd-dev \
    lintian \
    lld \
    lldb \
    llvm \
    locales \
    lsof \
    m4 \
    make \
    mesa-common-dev \
    mercurial \
    mold \
    nasm \
    ninja-build \
    openssh-client \
    openjdk-21-jdk-headless \
    patch \
    patchelf \
    perl \
    pipx \
    pkg-config \
    procps \
    python-is-python3 \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-venv \
    python3-wheel \
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-l10n-tools \
    qt6-tools-dev \
    qt6-tools-dev-tools \
    ripgrep \
    rpm \
    rsync \
    shellcheck \
    strace \
    subversion \
    sudo \
    squashfs-tools \
    tar \
    tini \
    tk-dev \
    unzip \
    uuid-dev \
    valgrind \
    wget \
    xauth \
    xmlto \
    xutils-dev \
    xvfb \
    xz-utils \
    yasm \
    zip \
    zlib1g-dev \
    zstd \
    && locale-gen en_US.UTF-8 \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

RUN existing_group="$(getent group "${BUILDER_GID}" | cut -d: -f1)" \
    && if [ -n "${existing_group}" ]; then groupmod --new-name builder "${existing_group}"; else groupadd --gid "${BUILDER_GID}" builder; fi \
    && existing_user="$(getent passwd "${BUILDER_UID}" | cut -d: -f1)" \
    && if [ -n "${existing_user}" ]; then usermod --login builder --home /home/builder --move-home --gid "${BUILDER_GID}" --shell /bin/bash "${existing_user}"; else useradd --uid "${BUILDER_UID}" --gid "${BUILDER_GID}" --create-home --shell /bin/bash builder; fi \
    && printf '%s\n' 'builder ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/builder \
    && chmod 0440 /etc/sudoers.d/builder

RUN mkdir -p /opt/node /opt/dotnet /opt/wildbuzzard-inputs \
    && curl -fL --retry 5 -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar -xJf /tmp/node.tar.xz --strip-components=1 -C /opt/node \
    && curl -fL --retry 5 -o /tmp/dotnet.tar.gz "https://builds.dotnet.microsoft.com/dotnet/Sdk/${DOTNET_VERSION}/dotnet-sdk-${DOTNET_VERSION}-linux-x64.tar.gz" \
    && echo "${DOTNET_SHA512}  /tmp/dotnet.tar.gz" | sha512sum --check --strict \
    && tar -xzf /tmp/dotnet.tar.gz -C /opt/dotnet \
    && curl -fL --retry 5 -o /opt/wildbuzzard-inputs/boost_1_88_0.tar.bz2 "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_1_88_0.tar.bz2" \
    && echo "${BOOST_SHA256}  /opt/wildbuzzard-inputs/boost_1_88_0.tar.bz2" | sha256sum --check --strict \
    && ln -s /opt/node/bin/node /usr/local/bin/node \
    && ln -s /opt/node/bin/npm /usr/local/bin/npm \
    && ln -s /opt/node/bin/npx /usr/local/bin/npx \
    && ln -s /opt/dotnet/dotnet /usr/local/bin/dotnet \
    && rm -f /tmp/node.tar.xz /tmp/dotnet.tar.gz

RUN python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir "aqtinstall==${AQTINSTALL_VERSION}" \
    && /opt/aqt/bin/aqt install-qt linux desktop "${QT_TOOLS_VERSION}" linux_gcc_64 -O /opt/Qt \
    && qt_lrelease="$(find "/opt/Qt/${QT_TOOLS_VERSION}" -type f -path '*/bin/lrelease' -print -quit)" \
    && test -n "${qt_lrelease}" \
    && ln -s "${qt_lrelease}" /usr/local/bin/lrelease \
    && test "$(lrelease -version 2>&1)" = "lrelease version ${QT_TOOLS_VERSION}"

RUN python3 -m venv /opt/uv \
    && /opt/uv/bin/pip install --no-cache-dir "uv==${UV_VERSION}" \
    && ln -s /opt/uv/bin/uv /usr/local/bin/uv \
    && ln -s /opt/uv/bin/uvx /usr/local/bin/uvx \
    && curl -fL --retry 5 -o /usr/local/bin/appimagetool "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage" \
    && echo "${APPIMAGETOOL_SHA256}  /usr/local/bin/appimagetool" | sha256sum --check --strict \
    && chmod 0755 /usr/local/bin/appimagetool

USER builder
WORKDIR /home/builder

RUN curl -fL --retry 5 -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum --check --strict \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --profile default --default-toolchain "${RUST_TOOLCHAIN}" \
    && rm -f /tmp/rustup-init \
    && rustup component add clippy rustfmt

USER root

RUN printf '%s\n' \
    'Defaults secure_path="/home/builder/.cargo/bin:/opt/dotnet:/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' \
    > /etc/sudoers.d/builder-path \
    && chmod 0440 /etc/sudoers.d/builder-path \
    && mkdir -p /workspace \
    && chown builder:builder /workspace

USER builder
WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash"]
