DIRS += ["browser"]

if CONFIG["WILDBUZZARD_PI_WEB_RUNTIME"]:
    GENERATED_FILES += ["wildbuzzard-pi-web-runtime.zip"]
    pi_web_runtime = GENERATED_FILES["wildbuzzard-pi-web-runtime.zip"]
    pi_web_runtime.script = "copy_pi_web_runtime.py"
    pi_web_runtime.flags = [CONFIG["WILDBUZZARD_PI_WEB_RUNTIME"]]
    pi_web_runtime.extra_deps = [
        "%" + CONFIG["WILDBUZZARD_PI_WEB_RUNTIME"],
        "pi-web-runtime-lock.json",
        "scripts/runtime-archive-manifest.py",
        "scripts/validate-pi-web-runtime-archive.py",
    ]

    FINAL_TARGET_FILES.runtime["pi-web"] += [
        "!wildbuzzard-pi-web-runtime.zip",
    ]

if CONFIG["WILDBUZZARD_TORRENT_RUNTIME"]:
    GENERATED_FILES += ["wildbuzzard-torrent-runtime.zip"]
    torrent_runtime = GENERATED_FILES["wildbuzzard-torrent-runtime.zip"]
    torrent_runtime.script = "copy_file.py"
    torrent_runtime.flags = [CONFIG["WILDBUZZARD_TORRENT_RUNTIME"]]
    torrent_runtime.extra_deps = ["%" + CONFIG["WILDBUZZARD_TORRENT_RUNTIME"]]

    FINAL_TARGET_FILES.runtime["torrent"] += [
        "!wildbuzzard-torrent-runtime.zip",
    ]

if CONFIG["WILDBUZZARD_JACKETT_MINI_RUNTIME"]:
    GENERATED_FILES += ["wildbuzzard-jackett-mini-runtime.zip"]
    jackett_mini_runtime = GENERATED_FILES["wildbuzzard-jackett-mini-runtime.zip"]
    jackett_mini_runtime.script = "copy_file.py"
    jackett_mini_runtime.flags = [CONFIG["WILDBUZZARD_JACKETT_MINI_RUNTIME"]]
    jackett_mini_runtime.extra_deps = ["%" + CONFIG["WILDBUZZARD_JACKETT_MINI_RUNTIME"]]

    FINAL_TARGET_FILES.runtime["jackett-mini"] += [
        "!wildbuzzard-jackett-mini-runtime.zip",
    ]

if CONFIG["WILDBUZZARD_SEARXNG_RUNTIME"]:
    GENERATED_FILES += [
        "wildbuzzard-searxng-runtime.zip",
        "wildbuzzard-searxng-2026.8.6+b023a28ba-source.tar.xz",
    ]
    searxng_runtime = GENERATED_FILES["wildbuzzard-searxng-runtime.zip"]
    searxng_runtime.script = "copy_file.py"
    searxng_runtime.flags = [CONFIG["WILDBUZZARD_SEARXNG_RUNTIME"]]
    searxng_runtime.extra_deps = ["%" + CONFIG["WILDBUZZARD_SEARXNG_RUNTIME"]]
    searxng_source = GENERATED_FILES[
        "wildbuzzard-searxng-2026.8.6+b023a28ba-source.tar.xz"
    ]
    searxng_source.script = "copy_file.py"
    searxng_source.flags = [CONFIG["WILDBUZZARD_SEARXNG_SOURCE"]]
    searxng_source.extra_deps = ["%" + CONFIG["WILDBUZZARD_SEARXNG_SOURCE"]]

    FINAL_TARGET_FILES.runtime["search"] += [
        "!wildbuzzard-searxng-runtime.zip",
    ]
    FINAL_TARGET_FILES.notices["source"] += [
        "!wildbuzzard-searxng-2026.8.6+b023a28ba-source.tar.xz",
        "packaging/searxng-release.cdx.json",
    ]

if CONFIG["WILDBUZZARD_ARTI"]:
    arti_name = "arti" + CONFIG["BIN_SUFFIX"]
    arti_provenance_name = "wildbuzzard-arti-2.5.1-provenance.zip"
    GENERATED_FILES += [arti_name, arti_provenance_name]
    arti_binary = GENERATED_FILES[arti_name]
    arti_binary.script = "copy_file.py"
    arti_binary.flags = [CONFIG["WILDBUZZARD_ARTI"]]
    arti_binary.extra_deps = [
        "%" + CONFIG["WILDBUZZARD_ARTI"],
        "%" + CONFIG["WILDBUZZARD_ARTI_PROVENANCE"],
        "scripts/arti-runtime-provenance.py",
        "third_party/arti.toml",
    ]
    arti_provenance = GENERATED_FILES[arti_provenance_name]
    arti_provenance.script = "copy_file.py"
    arti_provenance.flags = [CONFIG["WILDBUZZARD_ARTI_PROVENANCE"]]
    arti_provenance.extra_deps = [
        "%" + CONFIG["WILDBUZZARD_ARTI_PROVENANCE"],
    ]

    FINAL_TARGET_FILES.runtime["tor"] += [
        "!" + arti_name,
        "third_party/arti.toml",
    ]
    FINAL_TARGET_FILES.notices["source"] += [
        "!" + arti_provenance_name,
    ]
